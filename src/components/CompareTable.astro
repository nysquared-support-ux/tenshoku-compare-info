---
/**
 * CompareTable.astro — 比較表 component (Claude Design 学び統合)
 * 元: abc-hub/techgo/twinpro v2 の .compare-table パターン抽出
 *
 * 使用例:
 *   <CompareTable
 *     caption="エージェント比較"
 *     headers={['サービス', '対象', '料金', '強み']}
 *     rows={[
 *       { cells: ['ツインプロ', 'BIG4/会計士', '無料', ['会計士特化', 'BIG4 ネットワーク']] },
 *       { cells: ['MS-Japan', '管理部門', '無料', ['会計士求人多', '老舗']] },
 *     ]}
 *   />
 *
 * cells 内に配列を渡すと .cmp-tag (chip) として描画
 */
interface Cell {
  text?: string;
  tags?: string[];
}
interface Row {
  cells: (string | string[])[];
}
interface Props {
  caption?: string;
  headers: string[];
  rows: Row[];
}

const { caption = '', headers, rows } = Astro.props;
---

<div class="compare-wrap" role="region" aria-label={caption}>
  <table class="compare-table">
    {caption && <caption class="sr-only">{caption}</caption>}
    <thead>
      <tr>
        {headers.map((h) => <th scope="col">{h}</th>)}
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr>
          {row.cells.map((cell, i) => (
            <td>
              {Array.isArray(cell)
                ? cell.map((tag) => <span class="cmp-tag">{tag}</span>)
                : cell}
            </td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>
