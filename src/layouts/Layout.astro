---
import CookieBanner from '../components/CookieBanner.astro';
import Analytics from '../components/Analytics.astro';
import '../styles/design-tokens.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = '30-50代男性向けの転職エージェントを公開情報で比較。コンサル・IT・士業・建設施工管理など業種別に整理。',
} = Astro.props;

const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://tenshoku-compare-info.pages.dev';
// GSC verification: hardcoded (env var fallback も可)
const gscVerification = import.meta.env.PUBLIC_GSC_VERIFICATION || 'HRlkPakHcDHZPrhT1QR0bRiJrajC2-TjyqlvBl3gDsA';
---

<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  {gscVerification && <meta name="google-site-verification" content={gscVerification} />}
  <link rel="canonical" href={Astro.url.href} />

  <!-- OGP -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={Astro.url.href} />
  <meta property="og:type" content="article" />
  <meta property="og:site_name" content="30-50代男性向け転職比較情報サイト（PR）" />

  <!-- 構造化データ: Article -->
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Article',
    'headline': title,
    'description': description,
    'datePublished': '2026-04-25',
    'dateModified': '2026-05-02',
    'author': {
      '@type': 'Organization',
      'name': 'NY-squared',
    },
    'publisher': {
      '@type': 'Organization',
      'name': 'NY-squared',
    },
  })} />

  <!-- 構造化データ: BreadcrumbList (★Round Y 2026-05-02 [sdKG2oTfY8]) -->
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    'itemListElement': [
      { '@type': 'ListItem', 'position': 1, 'name': 'トップ', 'item': 'https://tenshoku-compare-info.pages.dev/' },
      { '@type': 'ListItem', 'position': 2, 'name': title, 'item': Astro.url.href },
    ],
  })} />

  <title>{title}</title>

  <!-- 子ページ注入用 head スロット -->
  <slot name="head" />
</head>
<body class="bg-white text-gray-800">
  <!-- グローバル PR表示（ファーストビュー） -->
  <div class="bg-yellow-100 border-b border-yellow-300 text-center py-2 text-sm">
    PR：本ページはアフィリエイト広告を利用しています | 各転職エージェント公式サイトではありません
  </div>

  <slot />

  <!-- フッター -->
  <footer class="bg-gray-100 mt-12 py-8 px-4 text-sm">
    <div class="max-w-3xl mx-auto">
      <p class="mb-2">
        <strong>運営者</strong>: NY-squared（個人事業）|
        <a href="/operator-info" class="underline">運営者情報</a> |
        <a href="/privacy-policy" class="underline">プライバシーポリシー</a> |
        <a href="/editorial-policy" class="underline">編集ポリシー</a>
      </p>
      <p class="mb-2">
        <button onclick="window.showCookieSettings && window.showCookieSettings()" class="underline text-blue-700">
          🍪 Cookie設定
        </button>
      </p>
      <p class="text-xs text-gray-600">
        本サイトはアフィリエイト広告を含むPR記事です。運営者は本サイト経由のお申込みにより提携先より報酬を受け取ります。
        本サイトは職業紹介事業者ではなく、求人紹介・採用判断は行いません。契約主体は各リンク先転職エージェントです。
        転職結果には個別状況により差があります（年収・職歴・業界等）。本サイトはキャリアコンサル監修ではありません。
      </p>
      <p class="text-xs text-gray-600 mt-2">
        © 2026 NY-squared. 最終確認日: 2026-04-25
      </p>
    </div>
  </footer>

  <CookieBanner />
  <Analytics />
</body>
</html>
