---
/**
 * 転職面接 自己紹介 LP (TechGo・Claude Design techgo 完全 class 構造準拠・★503 playbook Part A)
 * ★326 DRY engineer-1000man rich-v3 テンプレ流用・既存テキスト保持
 * ★441-EXT/★452: JSON-LD 2種 (Article/FAQPage) を RichLayout slot="head" で保持
 * ASP: TechGo a8mat=4B1LPN+E39C6Q+5B0Y+HV7V6 (★480 critical-urls.md L458 照合済)
 * ★327 backup: backups/2026-05-17-mensetsu-before-rich/
 */
import RichLayout from '../../layouts/RichLayout.astro';

const A8 = 'https://px.a8.net/svt/ejp?a8mat=4B1LPN+E39C6Q+5B0Y+HV7V6';
const title = '転職面接 自己紹介｜評価される構成・1 分 / 3 分テンプレートと職種別例文集 (2026年版・PR)';
const description = '転職面接の自己紹介で第一印象を上げたい方へ。面接官が評価する 3 要素・1 分 / 3 分テンプレート・職種別例文・NG パターンを公開情報ベースに整理した情報提供記事です (PR・アフィリエイト広告を含みます)。個別判断は各エージェントへご相談ください。';
const breadcrumb = [
  { name: 'ホーム', url: '/' },
  { name: 'IT エンジニア転職', url: '/high-class/' },
  { name: '転職面接 自己紹介' },
];

const articleSchema = {
  '@context': 'https://schema.org', '@type': 'Article', 'headline': title, 'description': description,
  'datePublished': '2026-05-08', 'dateModified': '2026-05-08',
  'author': { '@type': 'Organization', 'name': 'NY-squared', 'url': 'https://nysquared.com/' },
  'publisher': { '@type': 'Organization', 'name': 'NY-squared' },
  'articleSection': '転職面接対策', 'about': '転職面接 自己紹介の構成と例文',
};
const faq = [
  { q: '転職面接の自己紹介は何分が適切ですか?', a: '一般的に 1 分 (40-60 秒・約 200-300 字) が標準とされています。面接官から「3 分でお願いします」等の指定がある場合は 3 分版 (約 600-900 字) を準備しておくと安心です。指定がない場合は 1 分で簡潔に終えるのが推奨されます。' },
  { q: '自己紹介と志望動機は一緒に話すべきですか?', a: '一般的には別々に話すことが推奨されます。自己紹介は「どんな人か」を伝える時間、志望動機は「なぜこの会社か」を伝える時間で目的が異なります。ただし、自己紹介の最後に 1-2 文で志望動機の概要に触れるパターンは効果的とされています。' },
  { q: '自己紹介で職務経歴を全部話すべきですか?', a: '全部ではなく、応募職種に関連する経歴に絞ることが推奨されます。直近の職務 + 関連実績 1-2 件に絞り、詳細は「ご質問いただければお答えします」と締めることで、面接官の質問を誘発できます。' },
  { q: '面接官の評価ポイントは何ですか?', a: '一般的に ① コミュニケーション力 (構成・テンポ・伝わりやすさ) ② 職務との関連性 (応募職種にマッチする経歴・スキル) ③ 自己 PR の明確性 (強み + 根拠となる実績) の 3 要素が評価されるとされています。' },
  { q: '転職回数が多い場合はどう自己紹介すべきですか?', a: '転職理由に一貫性を持たせ、各経験で得たスキルが応募職種にどう活きるかを軸に組み立てることが推奨されます。回数を強調せず、各経験の「学び」と「成長」を中心に据える構成が一般的です。' },
  { q: 'ブランク期間がある場合はどう触れるべきですか?', a: 'ブランク期間中の活動 (学習・資格取得・育児・介護等) を簡潔に説明し、現在は転職活動に集中していることを伝えることが推奨されます。隠さず、前向きな姿勢で説明することが評価されるとされています。' },
  { q: 'オンライン面接と対面で自己紹介の違いはありますか?', a: 'オンラインは音声品質と視線が重要 (カメラを見て話す・通信環境確認)・対面は姿勢と表情が重要、という違いがあります。内容自体は基本的に同じですが、オンラインは少しゆっくり目に話すことが推奨されます。' },
  { q: '緊張して上手く話せない場合の対策は?', a: '事前準備の徹底 (テンプレート暗記より構成の理解)・録画して自分の話し方を客観確認・面接前に深呼吸 3 回・最初の 1 文を完璧に暗記する、の 4 点が一般的に推奨されます。' },
];
const faqSchema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  'mainEntity': faq.map(f => ({ '@type': 'Question', 'name': f.q, 'acceptedAnswer': { '@type': 'Answer', 'text': f.a } })),
};
---

<RichLayout title={title} description={description} breadcrumb={breadcrumb}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
  </Fragment>

  <!-- ============ FV ============ -->
  <section class="fv" aria-labelledby="fv-h1">
    <div class="container">
      <span class="fv-pill">転職面接 自己紹介 / 評価される構成 + 例文</span>
      <h1 id="fv-h1">
        転職面接 <span class="accent">自己紹介</span><br />
        評価される構成・1 分 / 3 分テンプレと職種別例文集
      </h1>
      <p class="lede">
        転職面接の自己紹介で評価されるのは「①コミュニケーション力 ②職務との関連性 ③自己 PR の明確性」の 3 要素です。1 分版 (40-60 秒・標準) と 3 分版 (詳細版) の 2 種類を準備し、面接官の指示に応じて使い分けることが推奨されます。
      </p>
      <ul class="fv-bullets">
        <li>面接官が評価する 3 要素を整理</li>
        <li>5 要素フレームワーク + 1 分 / 3 分テンプレート</li>
        <li>職種別の差別化ポイント + NG パターン 5 例</li>
        <li>厚労省・JILPT・国民生活センター・総務省統計局 出典明示</li>
      </ul>
      <div class="cta-block">
        <p class="cta-note"><span class="pr-tag">PR</span>A8.net 経由のアフィリエイトリンクです。クリックしても利用者の費用負担は生じません。</p>
        <a class="btn-cta" href={`${A8}&sitemicros=hub_fv`} rel="sponsored nofollow noopener" target="_blank" referrerpolicy="no-referrer-when-downgrade" data-cta="hub_fv">
          <span>TechGo 公式サイトで無料カウンセリング詳細を見る</span>
          <span class="arrow" aria-hidden="true">→</span>
        </a>
        <p class="btn-cta-sub">※ 公式サイトに遷移します。本ページはアフィリエイトプログラム参加に基づく PR 記事です。最新の対応エリア・料金等は遷移先公式情報をご確認ください。</p>
      </div>
      <div class="fv-meta">
        <span><b>公開日</b> 2026-05-08</span>
        <span><b>最終更新</b> 2026-05-08</span>
        <span><b>編集</b> NY-squared 編集部</span>
        <span><b>所要</b> 約 6 分</span>
      </div>
    </div>
  </section>

  <!-- ============ SECTION 01 最初の 40 秒 + 評価 3 要素 ============ -->
  <section class="lp-section" id="sec-1" aria-labelledby="h2-1">
    <div class="container">
      <p class="section-num">SECTION / 01</p>
      <h2 id="h2-1">転職面接の自己紹介は「最初の 40 秒」が決める</h2>
      <p class="section-lede">面接開始時の「まず自己紹介をお願いします」の 40-60 秒間で面接官は第一印象を形成し、その後の質問の方向性を決めます。自己紹介は面接全体の流れを決める重要なオープニングです。</p>

      <div class="branch-grid">
        <article class="branch">
          <span class="tag">評価 ①</span>
          <h4>コミュニケーション力</h4>
          <p>聞き手に伝わる構成・声量・話すテンポ・言葉の選び方。</p>
        </article>
        <article class="branch">
          <span class="tag">評価 ②</span>
          <h4>職務との関連性</h4>
          <p>応募職種にマッチする経歴・スキル・実績の整合性。</p>
        </article>
        <article class="branch">
          <span class="tag">評価 ③</span>
          <h4>自己 PR の明確性</h4>
          <p>自分の強み + 根拠となる実績数値の組み合わせ。</p>
        </article>
        <article class="branch">
          <span class="tag">使い分け</span>
          <h4>1 分 / 3 分</h4>
          <p>標準は 1 分 (40-60 秒)。「3 分でお願いします」等の指定時のみ 3 分版を使用。両方を準備しておくことが安心。</p>
        </article>
      </div>

      <p class="compare-note">※ 本記事は <a href="https://www.mhlw.go.jp/" target="_blank" rel="noopener">厚生労働省</a> 職業情報提供サイト + <a href="https://www.jil.go.jp/" target="_blank" rel="noopener">JILPT</a> + <a href="https://www.kokusen.go.jp/" target="_blank" rel="noopener">国民生活センター</a> + <a href="https://www.stat.go.jp/" target="_blank" rel="noopener">総務省統計局</a> + 各転職エージェント公開情報を整理した一般論であり、断定的事実ではありません。個別状況により大きく異なります。</p>

      <div class="cta-block tight">
        <a class="btn-cta" href={`${A8}&sitemicros=hub_features`} rel="sponsored nofollow noopener" target="_blank" referrerpolicy="no-referrer-when-downgrade" data-cta="hub_features">
          <span>評価 3 要素を踏まえ TechGo 公式サイトで詳細を確認する</span>
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ============ SECTION 02 5 要素フレームワーク + テンプレ ============ -->
  <section class="lp-section alt" id="sec-2" aria-labelledby="h2-2">
    <div class="container">
      <p class="section-num">SECTION / 02</p>
      <h2 id="h2-2">評価される自己紹介の構成 (5 要素フレームワーク) と例文</h2>
      <p class="section-lede">高評価を得る自己紹介は 5 要素で構成することが推奨されます。</p>
      <div class="card-grid">
        <div class="card">
          <h3>5 要素フレームワーク</h3>
          <p>① 名前と挨拶 (「本日はお時間をいただきありがとうございます。○○と申します」) ② 直近の職務概要 ③ 主要実績 1-2 件 (達成率・改善率・規模等の数値) ④ 強み (応募職種との接点) ⑤ 結び。構成順序は職種・面接官の好みで微調整可・最重要は②③④のバランス。</p>
        </div>
        <div class="card">
          <h3>1 分版テンプレート例文</h3>
          <p>本日はお時間をいただきありがとうございます。○○と申します。現在は△△株式会社で SaaS 営業として、エンタープライズ企業向けの新規開拓を担当しています。直近では年間目標の 130% を達成し、社内 MVP を受賞しました。お客様の課題を深く理解し、長期的な信頼関係を構築することを強みとしており、御社でもこの経験を活かして成長に貢献したいと考えております。本日はよろしくお願いいたします。(※実績数値・職種は応募先に合わせて置換)</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ SECTION 03 職種別差別化 ============ -->
  <section class="lp-section" id="sec-3" aria-labelledby="h2-3">
    <div class="container">
      <p class="section-num">SECTION / 03</p>
      <h2 id="h2-3">職種別 自己紹介の差別化ポイント</h2>
      <div class="compare-wrap">
        <table class="compare" aria-label="職種別自己紹介の差別化ポイント">
          <thead><tr><th>職種</th><th>差別化ポイント</th></tr></thead>
          <tbody>
            <tr><td>営業職</td><td>売上達成率・受注金額・顧客数等の数値実績中心。BtoB/BtoC・既存深耕/新規開拓の経験を明示</td></tr>
            <tr><td>エンジニア</td><td>技術スタック (言語/フレームワーク/インフラ)・プロジェクト規模 (チーム人数/期間)・技術選定の意思決定経験</td></tr>
            <tr><td>マーケティング</td><td>担当チャネル (Web/SEO/広告/SNS)・KPI 改善実績 (CTR/CVR/CPA)・予算規模</td></tr>
            <tr><td>コンサル</td><td>プロジェクト業界・課題解決のフレームワーク・クライアント規模・成果指標</td></tr>
            <tr><td>管理職</td><td>マネジメント人数・組織課題と解決アプローチ・組織変革の実績数値</td></tr>
          </tbody>
        </table>
      </div>
      <p class="compare-note">※ 職種別傾向は公開情報の整理であり、個別企業の評価軸は応募先により異なります。</p>
      <div class="cta-block tight">
        <a class="btn-cta" href={`${A8}&sitemicros=hub_salary`} rel="sponsored nofollow noopener" target="_blank" referrerpolicy="no-referrer-when-downgrade" data-cta="hub_salary">
          <span>職種別ポイントを踏まえ TechGo 公式サイトを確認する</span>
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ============ SECTION 04 NG パターン ============ -->
  <section class="lp-section alt" id="sec-4" aria-labelledby="h2-4">
    <div class="container">
      <p class="section-num">SECTION / 04</p>
      <h2 id="h2-4">やりがちな NG パターン (5 例) と練習・エージェント活用</h2>
      <div class="counter-box">
        <h3>📌 NG パターンと改善策 (公開情報整理)</h3>
        <div class="row"><b>職務経歴を全部話す</b><span>時間制限を意識せず網羅的に → 直近 + 関連実績 1-2 件に絞る</span></div>
        <div class="row"><b>志望動機を長々と</b><span>自己紹介と志望動機の混同 → 志望動機は別質問・1-2 文の概要のみ</span></div>
        <div class="row"><b>数値が一切ない抽象的な実績</b><span>感想ベース → 達成率・規模・改善率を必ず数値化</span></div>
        <div class="row"><b>転職理由を最初に話す</b><span>ネガティブ情報を冒頭に → 転職理由は別質問・自己紹介はポジティブに</span></div>
        <div class="row"><b>早口・棒読みで人柄が見えない</b><span>緊張・テンプレ暗記すぎ → 事前録画チェック・構成理解で柔軟対応</span></div>
        <p style="margin-top:12px;font-size:13px;color:var(--c-text-sub);">※ 自己紹介は事前準備で差がつくセクション。転職エージェントを活用すると模擬面接・実際の自己紹介フィードバック・職種別評価傾向情報を得られます。<br /><strong>YMYL リスク認識</strong>: 年収・キャリアは就業判断に直結。本記事は内定保証・効果保証ではなく、特定企業・エージェントを推奨するものでもありません。</p>
      </div>

      <div class="cta-block">
        <a class="btn-cta" href={`${A8}&sitemicros=hub_final`} rel="sponsored nofollow noopener" target="_blank" referrerpolicy="no-referrer-when-downgrade" data-cta="hub_final">
          <span>面接対策の最終確認は TechGo 公式サイトで</span>
          <span class="arrow" aria-hidden="true">→</span>
        </a>
        <p class="btn-cta-sub">※ 本記事は公開情報を整理した一般論であり、具体的な面接対策は各転職エージェントの模擬面接サービス等を活用してください。最終確認日: 2026-05-08。</p>
      </div>
    </div>
  </section>

  <!-- ============ SECTION 05 FAQ + 関連記事 ============ -->
  <section class="lp-section" id="sec-5" aria-labelledby="h2-5">
    <div class="container">
      <p class="section-num">SECTION / 05</p>
      <h2 id="h2-5">よくある質問・関連記事</h2>
      {faq.map((item) => (
        <div class="faq">
          <details>
            <summary>{item.q}</summary>
            <div>{item.a}</div>
          </details>
        </div>
      ))}
      <div class="card-grid">
        <div class="card">
          <h3>関連 Spoke LP</h3>
          <p>
            <a href="/osusume/">転職エージェント おすすめ 4 社比較</a> /
            <a href="/jiko-bunseki/">転職 自己分析 やり方</a> /
            <a href="/taishokuriyu/">転職面接 退職理由 答え方</a> /
            <a href="/40dai-koukai/">40 代後悔回避</a> /
            <a href="/40dai-revenge/">40 代リベンジ転職</a>
          </p>
        </div>
        <div class="card">
          <h3>公的相談窓口・支援機関</h3>
          <p>
            <a href="https://www.mhlw.go.jp/" target="_blank" rel="noopener">厚生労働省</a> — 職業情報提供サイト /
            <a href="https://www.jil.go.jp/" target="_blank" rel="noopener">JILPT</a> — 転職動向分析 /
            <a href="https://www.stat.go.jp/" target="_blank" rel="noopener">総務省統計局</a> — 労働力調査 /
            <a href="https://www.kokusen.go.jp/" target="_blank" rel="noopener">国民生活センター</a> — 消費者相談情報
          </p>
        </div>
      </div>
      <p class="compare-note">※ 本記事は 2026 年 5 月時点の公開情報をもとに作成。最新の面接トレンド・業界動向は各公式サイトでご確認ください。運営: <a href="/operator-info/">NY-squared (個人事業)</a> / <a href="/editorial-policy/">編集ポリシー</a> / <a href="/privacy-policy/">プライバシーポリシー</a>。本記事は内定保証・効果保証ではなく、特定エージェントを推奨するものでもありません。</p>
    </div>
  </section>

  <section class="lp-section alt" id="sec-asp-pr" aria-labelledby="h2-asp-pr">
    <div class="container">
      <p class="section-num">SECTION / PR・広告</p>
      <h2 id="h2-asp-pr">【PR・広告】転職エージェント の公開情報整理</h2>
      <p class="section-lede"><strong>本セクションは PR・広告枠</strong> です。アフィリエイト広告として「転職エージェント」の公開情報を整理しています。他事業者との優劣判断ではなく、広告主の公開情報として参照ください。</p>
      <div class="branch-grid">
      <article class="branch"><span class="tag">特徴①</span><h4>転職エージェント</h4><p>転職エージェントは求職者と求人企業をマッチングする選択肢の一つとされる傾向。複数エージェント並行利用が一般的とされる傾向です。</p></article>
      <article class="branch"><span class="tag">特徴②</span><h4>無料カウンセリング</h4><p>初回カウンセリング無料の傾向。気軽な相談・市場価値確認の選択肢とされる傾向です。</p></article>
      <article class="branch"><span class="tag">特徴③</span><h4>求人非公開</h4><p>一般公開されない非公開求人を扱う傾向。エージェント経由でのみアクセス可能な選択肢とされる傾向です。</p></article>
      <article class="branch"><span class="tag">特徴④</span><h4>業界特化</h4><p>業界特化型エージェントの選択肢。専門領域 (IT/会計/コンサル等) で深いマッチングとされる傾向です。</p></article>
      <article class="branch"><span class="tag">特徴⑤</span><h4>面接対策</h4><p>面接対策・職務経歴書添削の対応傾向。転職活動全般のサポート選択肢とされる傾向です。</p></article>
