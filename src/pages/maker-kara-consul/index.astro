 * ★480 a8mat 4B3SN7+KU6YA+5B0Y+5ZU29 verbatim
 * メイン KW: メーカーからコンサル (sv 推定 300-500・業界転身)
 */
import RichLayout from '../../layouts/RichLayout.astro';

const A8 = 'https://px.a8.net/svt/ejp?a8mat=4B3SN7+KU6YA+5B0Y+5ZU29';
const title = 'メーカーからコンサル 完全ガイド｜製造業出身者が狙えるキャリアパス・年収・選考対策｜MyVision (PR)';
const description = '製造業 (メーカー) 出身者がコンサル業界へ転職するための完全ガイド。評価される 5 スキル (生産管理 / SCM / 技術知見 / 業界知見 / プロジェクト経験)・狙えるファーム・年収レンジ・選考対策を公開情報ベースで整理。元コンサル無料カウンセリング活用法を解説 (PR・アフィリエイト広告を含みます)。';
const breadcrumb = [
  { name: 'ホーム', url: '/' },
  { name: 'コンサル転職ガイド', url: '/' },
  { name: 'メーカーからコンサル' },
];
const articleSchema = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  datePublished: '2026-05-21', dateModified: '2026-05-21',
  author: { '@type': 'Organization', name: 'NY-squared 編集部' },
  publisher: { '@type': 'Organization', name: 'NY-squared 編集部', url: 'https://tenshoku-compare-info.pages.dev/' },
};
const faq = [
  { q: 'メーカー出身者はコンサルに転職できますか?', a: 'コンサル特化エージェントの公開情報によれば、製造業 (メーカー) 出身者はコンサル業界の主要採用層の一つとされ、特に生産管理 / SCM / 技術企画 / 事業企画経験者の需要が高いとされる傾向です。利用者の9割が業界未経験とされ、メーカー出身者も多く含まれるとされる傾向です。' },
  { q: 'メーカーからコンサルへの年収アップは?', a: '一般公開情報によれば、メーカー → コンサル転職時の年収変動は様々で、30代前半メーカー 600-800万円 → コンサル 700-1,100万円帯への移行事例が報告されています。前職年収 + ファーム + ポジションにより変動します。詳細は <a href="/consul-nensyu/" class="underline">コンサル年収ガイド</a> 参照。' },
  { q: 'メーカー出身者が評価されるスキルは?', a: '一般的に生産管理 / SCM (サプライチェーン) / 技術知見 / 製造業界知見 / 大規模プロジェクト経験の5領域が評価される傾向とされています。本記事内で詳細を整理しています。' },
  { q: 'メーカーからコンサルで狙えるファームは?', a: '一般公開情報によれば、総合系 (アクセンチュア / アビーム / ベイカレント) ・BIG4・戦略系 (製造業インダストリー部門) が製造業出身者の主要転職先とされています。詳細は <a href="/consul-firm-hikaku/" class="underline">コンサル ファーム比較</a> 参照。' },
  { q: '技術職 (研究開発・設計) でもコンサル転職できますか?', a: '一般的に技術職出身者は、技術理解 + 製品知見 + R&D 経験を活かせる技術コンサル / DX 案件で評価される傾向とされています。文系職種より転身パスが限定的なケースもありますが、専門性が強みになるとされています。' },
  { q: 'メーカーからコンサルの選考対策は?', a: '一般的に書類選考 → ケース面接 (製造業課題) → 役員面接の流れで、実務経験のコンサル評価軸への翻訳が重要とされています。元コンサル添削が一般的に推奨されます。詳細は <a href="/consul-case-mensetsu/" class="underline">ケース面接対策</a> 参照。' },
];
const faqSchema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faq.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const breadcrumbSchema = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: breadcrumb.map((b, i) => ({
    '@type': 'ListItem', position: i + 1, name: b.name,
    ...(b.url ? { item: 'https://tenshoku-compare-info.pages.dev' + b.url } : {}),
  })),
};
---

<RichLayout title={title} description={description} breadcrumb={breadcrumb}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
  </Fragment>

  <section class="fv" aria-labelledby="fv-h1">
    <div class="container">
      <span class="fv-pill">メーカー → コンサル / 業界転身完全ガイド</span>
      <h1 id="fv-h1"><span class="accent">メーカーからコンサル</span> 完全ガイド<br />製造業出身者が狙えるキャリアパス・年収・選考対策</h1>
      <p class="lede"><strong>結論 (一般的傾向)</strong>: 製造業 (メーカー) 出身者は<strong>コンサル業界の主要採用層の一つ</strong>とされ、特に生産管理 / SCM / 技術企画 / 事業企画経験者の需要が高いとされる傾向です。本記事ではメーカー出身者が評価される 5 スキル + 狙えるファーム + 年収レンジ + 選考対策を公開情報ベースで整理します。※ 以下はすべて公開情報・業界一般論ベースの整理であり、断定的結論ではありません。</p>
      <ul class="fv-bullets">
        <li>メーカー出身者が評価される 5 スキル</li>
