---
import RichLayout from '../../layouts/RichLayout.astro';

const title = 'SES からの転職手続きの整理｜次のキャリアへの進め方 (2026年版・PR)';
const description = 'SES (システムエンジニアリングサービス) からの転職手続き・次のキャリアの選択肢を、公開情報をもとに中立的に整理した情報提供記事です(PR・アフィリエイト広告を含みます)。';
const breadcrumb = [
  { name: 'ホーム', url: '/' },
  { name: '転職' },
];
const faq = [
  { q: 'SES から自社開発に転職できますか？', a: 'SES の実務経験は自社開発企業への転職時の参考情報となる選択肢が整理されているとされています。スキル整理・実績の整理が推奨されます。' },
  { q: '退職時期はいつが良いですか？', a: 'プロジェクト区切り・有給消化を考慮した計画が推奨される選択肢とされています。事前のエージェント相談が推奨されます。' },
  { q: '有給消化は必ずできますか？', a: '労働基準法で有給休暇の権利が定められているとされています。退職時の有給消化は計画的な相談が推奨されます。' },
  { q: '退職時の引継ぎ期間は？', a: '業務内容により異なるとされていますが、一般に1〜3ヶ月程度の選択肢が整理されているとされています。' },
  { q: 'エージェントは SES 経験者でも利用できますか？', a: 'SES 経験者向けの転職支援サービスが公表されているとされています。担当業務の実績整理が推奨されます。' }
];
---

<RichLayout title={title} description={description} publishedDate="2026-06-05" modifiedDate="2026-06-05" breadcrumb={breadcrumb} faq={faq}>
  <div class="pr-strip">本ページはアフィリエイト広告 (A8.net 経由) を利用しています。IT エンジニア専門の転職エージェントの一般情報を中立的に整理します。<span class="pr-tag">PR</span></div>
  <section class="fv" aria-labelledby="fv-h1">
    <div class="container">
      <span class="fv-pill">SES / 転職</span>
      <h1 id="fv-h1"><span class="accent">SES からの転職手続きの整理</span><br />次のキャリアへの進め方</h1>
      <p class="lede">SES から事業会社・自社開発企業への転職は、計画的な準備が選択肢として整理されています。本記事では公的情報をもとに中立的に整理します。</p>
      <ul class="fv-bullets">
        <li>SES からの転職の一般情報</li>
        <li>次のキャリアの選択肢</li>
        <li>スキル整理の進め方</li>
        <li>退職手続きの確認事項</li>
      </ul>
      <div class="cta-block">
        <p class="cta-note">本ページはアフィリエイト広告を利用しています。<span class="pr-tag">PR</span></p>
