const breadcrumb = [
  { name: 'ホーム', url: '/' },
  { name: 'IT エンジニア転職', url: '/high-class/' },
  { name: '第二新卒エンジニア転職' },
];

const breadcrumbSchema = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  'itemListElement': [
    { '@type': 'ListItem', 'position': 1, 'name': 'トップ', 'item': 'https://tenshoku-compare-info.pages.dev/' },
    { '@type': 'ListItem', 'position': 2, 'name': '第二新卒エンジニア転職', 'item': 'https://tenshoku-compare-info.pages.dev/dainishinsotsu-engineer-tenshoku/' },
  ],
};
const faq = [
  { q: '第二新卒エンジニアの年収はどれくらいですか?', a: '一般的に新卒 1-3 年で 350-500 万円・転職で +50-150 万円のアップ事例があるとされています。但しスキル・転職先によって大きく異なります。' },
  { q: 'スキル不足でも転職できますか?', a: '一般的に第二新卒はポテンシャル採用枠が存在するとされ、基礎スキル + 学習姿勢で転職事例が多数あります。実務 1 年以上が一つの目安とされています。' },
  { q: '退職前に転職活動すべきですか?', a: '一般的に在職中の転職活動が推奨されているとされています。退職後は経済的不安 + 期間制約で焦り判断のリスクがあるとされています。' },
  { q: 'SES → 自社開発は可能ですか?', a: '一般的に第二新卒の SES → 自社開発転身事例は多いとされています。技術スタック学習 + ポートフォリオ + 主体性アピールが評価される傾向とされています。' },
];
const faqSchema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  'mainEntity': faq.map(f => ({ '@type': 'Question', 'name': f.q, 'acceptedAnswer': { '@type': 'Answer', 'text': f.a } })),
};
---

<RichLayout title={title} description={description} breadcrumb={breadcrumb}>
