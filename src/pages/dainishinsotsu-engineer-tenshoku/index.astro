            <tr><td>1 年 (新卒 +1)</td><td>350-450 万</td><td>400-550 万 (+50-100)</td></tr>
            <tr><td>2 年</td><td>400-500 万</td><td>450-600 万 (+50-150)</td></tr>
            <tr><td>3 年</td><td>450-550 万</td><td>500-700 万 (+50-200)</td></tr>
