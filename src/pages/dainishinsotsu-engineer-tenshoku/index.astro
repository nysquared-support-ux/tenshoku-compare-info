  <!-- ============ SECTION 01 市場価値 ============ -->
  <section class="lp-section" id="sec-1" aria-labelledby="h2-1">
    <div class="container">
      <p class="section-num">SECTION / 01</p>
      <h2 id="h2-1">第二新卒の市場価値</h2>
      <p class="section-lede">第二新卒 (新卒 1-3 年) は以下の市場価値を持つとされています。</p>

      <div class="branch-grid">
        <article class="branch">
          <span class="tag">市場価値 ①</span>
          <h4>ポテンシャル採用枠</h4>
          <p>スキル不足でも学習姿勢で採用される。</p>
        </article>
        <article class="branch">
          <span class="tag">市場価値 ②</span>
          <h4>第二新卒専門枠</h4>
          <p>新卒 1-3 年向け求人多数。</p>
        </article>
        <article class="branch">
          <span class="tag">市場価値 ③</span>
          <h4>柔軟性</h4>
          <p>新しい技術スタック習得が早い。</p>
        </article>
        <article class="branch">
          <span class="tag">市場価値 ④</span>
          <h4>カルチャー適応</h4>
          <p>旧来の慣習に染まっていない強み。</p>
        </article>
