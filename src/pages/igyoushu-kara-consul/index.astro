const description = '異業種からコンサル業界へ転職するための完全ガイド。前職業界別 (IT・金融・製造・商社・公務員・営業等) の転身パス・評価される共通スキル・選考対策を公開情報ベースで全方位整理。利用者の9割が業界未経験のMyVision活用法を解説 (PR・アフィリエイト広告を含みます)。';
const breadcrumb = [
  { name: 'ホーム', url: '/' },
