            <tr><td>商社</td><td>戦略系 / FAS / 総合系</td><td>事業投資 / 海外 / 多業界知見</td><td><a href="/shosha-kara-consul/" class="underline">商社からコンサル</a></td></tr>
            <tr><td>官公庁 / 公務員</td><td>公共系 (野村総研等) / BIG4 公共</td><td>政策立案 / 公共調達 / 行政知見</td><td><a href="/koumuin-kara-consul/" class="underline">公務員からコンサル</a></td></tr>
            <tr><td>大手事業会社 (経営企画)</td><td>戦略系 / 総合系</td><td>事業戦略 / 経営企画 / KPI 設計</td><td><a href="/consul-tenshoku-mikeiken/" class="underline">未経験コンサル</a></td></tr>
