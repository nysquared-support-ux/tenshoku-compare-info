      <div class="compare-wrap">
        <table class="compare" aria-label="前職業界別 転身パス">
          <thead><tr><th>前職業界</th><th>狙えるファーム</th><th>評価される経験</th><th>詳細ガイド</th></tr></thead>
          <tbody>
            <tr><td>IT / SIer</td><td>総合系 / IT 系 (アクセンチュア等)</td><td>クラウド / DX / PM 経験</td><td><a href="/it-consul-tenshoku/" class="underline">IT コンサル</a></td></tr>
            <tr><td>金融 (銀行 / 証券)</td><td>FAS / BIG4 / 戦略系</td><td>財務分析 / M&A / リスク管理</td><td><a href="/finance-kara-consul/" class="underline">金融からコンサル</a></td></tr>
