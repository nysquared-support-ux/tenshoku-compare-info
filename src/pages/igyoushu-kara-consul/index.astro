const faq = [
  { q: '異業種からコンサルに転職できますか?', a: 'コンサル特化エージェントの公開情報によれば、利用者の約9割が業界未経験で、IT・金融・製造・商社・官公庁・営業等の多様な異業種からの転職に成功しているとされています。前職経験をコンサル評価軸に翻訳できれば、業界を問わず挑戦可能とされる傾向です。' },
  { q: '異業種からの転職で評価される共通スキルは?', a: '一般的に論理的思考力・課題解決志向・成果インパクト・コミュニケーション能力・学習意欲の5軸が、業界を問わず評価される共通スキルとされています。詳細は <a href="/consul-jiko-pr/" class="underline">コンサル 自己PR ガイド</a> 参照。' },
  { q: 'どの業界からの転職が多いですか?', a: '一般公開情報によれば、IT・SIer / 金融 (銀行・証券) / 大手事業会社 (経営企画) / 商社 / 官公庁 / メーカー等が主要な前職業界とされています。本記事で業界別の転身パスを整理しています。' },
  { q: '異業種からの転職で年収はどう変わりますか?', a: '一般公開情報によれば、前職業界 + 年収水準により様々で、20-50%のアップ事例も報告される一方、もともと高年収の業界 (商社 / 投資銀行) からは横ばいのケースもあるとされています。詳細は <a href="/consul-nensyu/" class="underline">コンサル年収ガイド</a> 参照。' },
  { q: '異業種出身者の選考対策は?', a: '一般的に前職経験のコンサル評価軸への翻訳 + ケース面接対策 + 志望動機の整理が必須とされています。元コンサルの添削 + 模擬面接が一般的に推奨されます。詳細は <a href="/consul-case-mensetsu/" class="underline">ケース面接対策</a> 参照。' },
  { q: '未経験 + 異業種でも本当に大丈夫ですか?', a: 'コンサル特化エージェントの公開情報によれば、利用者の9割が業界未経験で選考突破に成功しているとされる傾向です。「異業種だから不利」というより「前職経験をどう翻訳するか」が鍵とされています。詳細は <a href="/consul-tenshoku-mikeiken/" class="underline">未経験 コンサル 転職</a> 参照。' },
];
const faqSchema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faq.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const breadcrumbSchema = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: breadcrumb.map((b, i) => ({
    '@type': 'ListItem', position: i + 1, name: b.name,
    ...(b.url ? { item: 'https://tenshoku-compare-info.pages.dev' + b.url } : {}),
