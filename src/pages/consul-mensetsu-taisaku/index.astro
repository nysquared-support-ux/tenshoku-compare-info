const faq = [
  { q: 'コンサルの面接にはどんな種類がありますか?', a: 'コンサルの選考では一般的に、ケース面接、行動面接 (フィット面接・経験面接)、グループディスカッション (GD) などが課されるとされています。ファームにより構成は異なりますが、複数の面接形式への総合的な対策が必要とされています。' },
  { q: 'ケース面接と行動面接の違いは何ですか?', a: 'ケース面接はビジネス課題への論理的思考・構造化能力を見る面接、行動面接 (フィット面接) は過去の経験・志望動機・カルチャーフィットを見る面接とされています。両者は評価軸が異なるため、それぞれ別の準備が必要とされています。' },
  { q: 'コンサル面接対策はいつから始めるべきですか?', a: '一般的に、特にケース面接は十分な準備期間と反復練習が必要とされるため、選考の数週間〜数ヶ月前から計画的に対策を始めるのが望ましいとされています。早めの準備が突破率に影響するとされています。' },
  { q: 'グループディスカッション (GD) では何が見られますか?', a: 'GDでは、論理的な発言、議論への貢献、チームでの協調性、リーダーシップやファシリテーション力などが見られる傾向にあるとされています。発言量だけでなく議論の質への貢献が重視されるとされています。' },
  { q: 'コンサル面接対策は独学でも可能ですか?', a: '書籍やオンライン教材での独学も可能とされていますが、特にケース面接は模擬面接でのフィードバックが対策の質を大きく高めるとされています。コンサル特化エージェントの元コンサルによる模擬面接サポートの活用が有効とされています。' },
  { q: '面接で志望動機はどう準備すべきですか?', a: '「なぜコンサルか」「なぜこのファームか」「中長期のキャリア構想」を、過去の実績 + ファーム特性で論理的に接続して語れるよう準備することが、行動面接での評価につながるとされています。' },
];
const faqSchema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faq.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
