  { name: 'コンサル転職ガイド', url: '/' },
  { name: 'コンサル ポートフォリオキャリア' },
];
const articleSchema = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  datePublished: '2026-05-24', dateModified: '2026-05-24',
  author: { '@type': 'Organization', name: 'NY-squared 編集部' },
  publisher: { '@type': 'Organization', name: 'NY-squared 編集部', url: 'https://tenshoku-compare-info.pages.dev/' },
};
const faq = [
  { q: 'ポートフォリオキャリアとは何ですか?', a: '一般に、ポートフォリオキャリアとは、複数の仕事・役割を組み合わせて働くキャリアスタイルを指すとされています。複業・フリーランス・パラレルワーク・起業 + 顧問等の形態があるとされています。' },
  { q: '複業と副業の違いは何ですか?', a: '一般公開情報によれば、明確な定義はありませんが、複業は複数の本業を持つ意識、副業は本業 + 補完的な仕事という使い分けがされる傾向にあるとされています。' },
  { q: 'コンサル経験はフリーランスとして活かせますか?', a: '一般に、コンサル経験は専門性・問題解決スキルとして活かしやすい傾向にあるとされていますが、案件獲得・税務処理等の独立特有のスキルも必要とされています。' },
  { q: '収入は正社員より高くなりますか?', a: '一般公開情報によれば、案件次第で高くも低くもなり得るとされており、安定性とのトレードオフがあるとされています。' },
  { q: '会社員からポートフォリオキャリアへの移行は段階的で良いですか?', a: '一般に、本業を続けながら副業から始める段階的移行は、リスクを抑える選択肢とされていますが、就業規則の確認が必須とされています。' },
  { q: 'エージェントを使うメリットは何ですか?', a: 'コンサル特化エージェントの利用は、業務委託・フリーランス案件の情報補完を支援する効果があるとされていますが、必ず有利になる性質のものではありません。最終的な意思決定はご自身で行う必要があります。' }
];
const faqSchema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faq.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const breadcrumbSchema = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: breadcrumb.map((b, i) => ({
    '@type': 'ListItem', position: i + 1, name: b.name,
    ...(b.url ? { item: 'https://tenshoku-compare-info.pages.dev' + b.url } : {}),
  })),
};
---

<RichLayout title={title} description={description} breadcrumb={breadcrumb}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
  </Fragment>

  <section class="fv">
    <div class="container">
      <h1>コンサルのポートフォリオキャリア完全ガイド｜複業・独立・パラレルワークの選び方 (2026年5月時点・公開情報ベース・PR)</h1>
