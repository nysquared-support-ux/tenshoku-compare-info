const faq = [
  { q: 'ローランドベルガーとはどんなファームですか?', a: 'ローランドベルガー (Roland Berger) は1967年にドイツで創業した、欧州発祥の戦略コンサルティングファームとされています。米国系の MBB (McKinsey/BCG/Bain) とは異なる欧州系の戦略名門として、自動車・製造・インダストリー領域に特に強みがあるとされる傾向です。' },
  { q: 'ローランドベルガーの年収レンジはどのくらいですか?', a: '一般公開情報によれば、ジュニアコンサルタント 600-900万円、コンサルタント 1,000-1,500万円、プロジェクトマネージャー 1,500-2,200万円、プリンシパル 2,200-2,800万円、パートナー 3,000万円超の事例が報告されています。戦略系の中で高水準とされる傾向です。詳細は <a href="/consul-nensyu/" class="underline">コンサル年収ガイド</a> 参照。' },
  { q: 'ローランドベルガーの選考難度はどのくらいですか?', a: '一般的に戦略系ファームとして高難度とされ、ケース面接 + 役員面接の複数ラウンド構成と一般的に言われます。独学では到達しにくく、元コンサルとの集中的な模擬面接が一般的に推奨されます。詳細は <a href="/consul-case-mensetsu/" class="underline">ケース面接対策</a> 参照。' },
  { q: 'ローランドベルガーの強み領域は?', a: '一般公開情報によれば、自動車・モビリティ・製造業・インダストリーグッズ・エネルギー領域に特に強みがあるとされています。欧州系ならではのインダストリー知見が特徴とされる傾向です。' },
  { q: 'ローランドベルガーと MBB の違いは?', a: 'ローランドベルガー = 欧州発祥 + 自動車/製造/インダストリー強み + 実務寄り、MBB (米国系) = グローバルネットワーク + 抽象度高い戦略立案という特性の違いがあるとされています。詳細は <a href="/senryaku-consul-tenshoku/" class="underline">戦略コンサル 転職</a> 参照。' },
  { q: '未経験からローランドベルガーに転職できますか?', a: '一般的にポテンシャル採用 + 論理思考力 + ケース面接突破力があれば挑戦可能とされていますが、戦略系のため採用枠は限られています。特に自動車・製造業の業界知見があれば評価されやすい傾向とされる傾向です。詳細は <a href="/consul-tenshoku-mikeiken/" class="underline">未経験 コンサル 転職</a> 参照。' },
];
const faqSchema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
