const faq = [
  { q: 'Big4マネージャーから事業会社のCFO候補への転職は現実的ですか？', a: 'はい、現実的なキャリアパスの一つとされます。監査法人で培った高度な財務会計知識やマネジメント経験は、事業会社で高く評価される傾向にあります。ただし、事業戦略への深い理解も求められるため、自身のスキルセットと企業のニーズを慎重に照らし合わせることが重要です。厚生労働省の職業情報提供サイト（jobtag）でも、公認会計士のキャリアパスとして経営層への道を例示しています。' },
  { q: 'Big4の8-12年目マネージャーの転職活動には、どのくらいの期間がかかりますか？', a: '一般的に3ヶ月から6ヶ月程度が目安とされますが、パートナー候補や役員クラスといったハイクラス求人の場合、選考が慎重に進められるため、それ以上の期間を要する可能性も考慮すべきです。現職の繁忙期なども考慮し、少なくとも半年前から計画的に情報収集を開始することが、納得のいく転職活動につながると考えられます。' },
  { q: 'FASと戦略コンサルでは、求められるスキルセットにどのような違いがありますか？', a: 'FAS（Financial Advisory Service）ではM&Aや事業再生など、財務の専門性を深く掘り下げたスキルが中心となります。一方、戦略コンサルでは財務知識に加え、業界分析、新規事業立案、マーケティング戦略など、より広範な経営課題解決能力が求められます。ご自身の強みやキャリアの方向性に応じて、どちらの道に進むか検討することが推奨されます。' },
  { q: 'ハイクラス向け転職エージェントを利用する際の注意点は何ですか？', a: '担当コンサルタントの専門性と相性が非常に重要です。ご自身の専門分野や目指すキャリアへの理解が浅い場合、適切な求人紹介が期待できない可能性があります。複数のエージェントに登録し、面談を通じて最も信頼できるパートナーを見極めることが成功の鍵です。なお、職業安定法に基づき、求人内容と実際の労働条件が異なる場合は、適切な窓口に申し出ることが可能です。' },
  { q: 'Big4マネージャーとしてのキャリア価値を最大化する転職先の選び方を教えてください。', a: '自身の長期的なキャリアビジョンを明確にすることが最も重要です。専門性をさらに高めたいのか、経営サイドへ軸足を移したいのかによって、最適な選択肢は異なります。FAS、戦略コンサル、事業会社のCFO候補、PEファンドなど多様な道を比較検討し、各社のカルチャーや成長性、報酬体系を総合的に判断することが、後悔のない選択につながると一般にいわれます。' },
  { q: '在職中であることが現職に知られてしまうリスクはありますか？', a: 'ご本人の許可なく、個人情報や活動状況を外部に開示することは一切ないとされています。応募先企業への情報提供も、必ずご本人の同意を得てから行うのが一般的とされます。匿名でのキャリア相談から始められるエージェントが多く、お気軽にご利用いただける傾向にあるとされています。' },
  { q: 'すぐに転職するつもりはないのですが、相談だけでも可能ですか？', a: 'はい、可能が一般的です。まずはご自身の市場価値を客観的に把握したい、中長期的なキャリアプランについて専門家の意見を聞きたい、といった目的でのご相談も歓迎されているとされます。無理に転職をお勧めすることはないとされ、情報収集の場としてご活用いただける傾向にあるとされています。' },
];
const faqExtra = [
  { q: '士業特化と総合型エージェントの違いは?', a: '公開情報上、士業特化エージェントは ①担当者の士業知見が深い ②監査法人・税理士法人ハイクラス非公開求人へのアクセス ③年収交渉時の業界相場知見、の 3 点が強みとされています。一方、総合型は求人数の多さ・他業界比較が強みとされています。両者併用が推奨されるケースが多いとされています。' },
  { q: '会計事務所から税理士法人への転職は可能ですか?', a: '公開情報上、会計事務所 (中小) から税理士法人 (Big4・大手) への転職は可能とされていますが、実務経験・スキル・年齢により難易度が異なるとされています。税理士有資格者の場合は比較的選択肢が広いとされています。詳細は士業特化エージェントへご相談ください。' },
];
const faqSchema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
