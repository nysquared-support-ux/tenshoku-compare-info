import RichLayout from '../../layouts/RichLayout.astro';

const title = 'エンジニアから PM (プロジェクトマネージャ) へのステップアップの整理 (2026年版・PR)';
const description = 'エンジニアから PM (プロジェクトマネージャ) へのキャリアステップアップの一般情報を、公開情報をもとに中立的に整理した情報提供記事です(PR・アフィリエイト広告を含みます)。';
const breadcrumb = [
  { name: 'ホーム', url: '/' },
  { name: 'PM' },
];
const faq = [
  { q: 'PM になるのに必要な経験は？', a: '技術経験 + リーダー・サブリーダー経験が選考参考情報となる選択肢が整理されているとされています。詳細は求人により異なるとされています。' },
  { q: 'PMP は必要ですか？', a: '必須ではないとされていますが、選考時の参考情報となる選択肢が公表されているとされています。学習内容は実務にも活用される選択肢が整理されています。' },
  { q: '年収は上がりますか？', a: '求人・企業により異なるとされていますが、PM ポジションは年収レンジが高めに設定される選択肢が一般的とされています。' },
  { q: 'マネジメント経験がない場合は？', a: '計画的な学習・社内でのリーダー・サブリーダー経験積みが推奨される選択肢とされています。エージェント相談で学習方針の整理が推奨されます。' },
  { q: 'エージェントの PM 求人は多い？', a: 'PM 求人は IT 業界全体で公表されているとされ、エージェントを通じた相談が一般的とされています。' }
];
---

<RichLayout title={title} description={description} publishedDate="2026-06-05" modifiedDate="2026-06-05" breadcrumb={breadcrumb} faq={faq}>
