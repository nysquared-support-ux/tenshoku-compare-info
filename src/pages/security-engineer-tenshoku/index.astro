const faq = [
  { q: '未経験からセキュリティエンジニアに転職することは可能ですか？', a: '未経験からの転職は挑戦的ですが、ITインフラやネットワークの基礎知識、関連資格の取得が有利に働くとされます。経済産業省が推進する「情報セキュリティマネジメント試験」などの合格は、知識レベルの客観的な証明となり、ポテンシャル採用の可能性を高める一助となることが期待されます。' },
  { q: 'SOCアナリストとペネトレーションテスターの年収帯はどの程度異なりますか？', a: '公開情報や求人データを基にすると、SOCアナリストの年収目安は400万～800万円、より高度な専門性が求められるペネトレーションテスターは600万～1200万円以上が一般的とされます。経験年数や保有スキル、企業の規模により大きく変動するため、個別の求人内容の確認が重要です。' },
  { q: 'CISO（最高情報セキュリティ責任者）を目指すためのキャリアパスを教えてください。', a: 'CISOへの道は、技術的専門性と経営的視点の両方が求められます。一般的には、SOC/CSIRTでの実務経験を積み、セキュリティコンサルタントやリスク管理部門を経てマネジメント経験を積むキャリアパスが考えられます。当記事の「セキュリティエンジニアの5領域」もご参照ください。' },
  { q: '転職活動でセキュリティ関連スキルをアピールする際の注意点は何ですか？', a: '抽象的な表現を避け、具体的な実績を数値で示すことが重要です。例えば「脆弱性診断を実施」ではなく、「OWASP Top 10に基づきWebアプリの脆弱性診断を行い、SQLインジェクションなど5件の重大な脆弱性を発見・報告した」のように、用いた技術や成果を明確にすることが求められます。' },
  { q: '今後、セキュリティエンジニアの需要はどのように変化すると予測されますか？', a: 'DX推進やサイバー攻撃の巧妙化に伴い、需要は引き続き高まると予測されます。特にクラウドやIoT領域のセキュリティ専門家の市場価値は高まる傾向にあります。総務省の「サイバーセキュリティ政策」でも人材育成の重要性が指摘されており、将来性の高い職種と一般に考えられています。' },
];
const faqSchema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  'mainEntity': faq.map(f => ({ '@type': 'Question', 'name': f.q, 'acceptedAnswer': { '@type': 'Answer', 'text': f.a } })),
};
