import RichLayout from '../../layouts/RichLayout.astro';

const A8 = 'https://px.a8.net/svt/ejp?a8mat=4B1LPN+E39C6Q+5B0Y+HV7V6';
const title = 'エンジニア 職務経歴書 書き方完全ガイド｜STAR フレーム + 技術スタック + NG パターン（2026年版・PR）';
const description = 'IT エンジニア向け職務経歴書の書き方を、STAR フレームワーク + 技術スタック記載方法 + 採用担当者が見るポイント + NG パターンで整理した情報提供記事です（PR・アフィリエイト広告を含みます）。';
const breadcrumb = [
  { name: 'ホーム', url: '/' },
  { name: 'IT エンジニア転職', url: '/high-class/' },
  { name: 'エンジニア 職務経歴書ガイド' },
];

const breadcrumbSchema = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  'itemListElement': [
    { '@type': 'ListItem', 'position': 1, 'name': 'トップ', 'item': 'https://tenshoku-compare-info.pages.dev/' },
    { '@type': 'ListItem', 'position': 2, 'name': 'エンジニア 職務経歴書ガイド', 'item': 'https://tenshoku-compare-info.pages.dev/engineer-shokumukeirekisho/' },
  ],
};
const faq = [
  { q: 'エンジニアの職務経歴書は何枚が目安ですか?', a: '一般的に A4 サイズで 2-3 枚が目安とされています。実務 10 年以上のシニアでも 4 枚以内に収めることが推奨されます。' },
  { q: '実績の書き方が分かりません', a: 'STAR フレームワーク (Situation/Task/Action/Result) で構造化することが一般的に推奨されています。数値 (パフォーマンス改善 X% / コスト削減 Y 円 / ユーザー数 Z) で具体性を担保します。' },
  { q: '技術スタックはどう書けば良いですか?', a: '一般的にカテゴリ別 (言語 / フレームワーク / DB / インフラ / ツール) に整理 + 各項目の習熟度 (実務 N 年 / 業務利用 / 学習中) を明示することが推奨されています。' },
  { q: '副業・個人開発の実績は書くべきですか?', a: '一般的にエンジニア採用では副業・個人開発・OSS コントリビュートの実績は積極的に書くことが推奨されているとされています。但し本業の業務情報との切り分けに注意が必要です。' },
];
const faqSchema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  'mainEntity': faq.map(f => ({ '@type': 'Question', 'name': f.q, 'acceptedAnswer': { '@type': 'Answer', 'text': f.a } })),
};
---

<RichLayout title={title} description={description} breadcrumb={breadcrumb}>
