const title = '経営企画への転職の整理｜キャリア整理の進め方 (2026年版・PR)';
const description = '事業会社経営企画への転職の一般情報を、公開情報をもとに中立的に整理した情報提供記事です(PR・アフィリエイト広告を含みます)。';
const breadcrumb = [
  { name: 'ホーム', url: '/' },
  { name: '転職' },
];
const faq = [
  { q: '経営企画への転職市場は活発ですか？', a: '経営企画は事業会社で広く設置されている部門とされ、転職市場での求人も公表されています。' },
  { q: 'コンサル経験は必要ですか？', a: '必須ではないとされていますが、戦略立案経験は選考参考情報となる選択肢が整理されているとされています。' },
  { q: '年収はどう変化しますか？', a: '求人・企業により異なるとされていますが、経営企画ポジションは年収レンジが幅広い選択肢として整理されているとされています。' },
  { q: 'MBA は必要ですか？', a: '必須ではないとされていますが、選考時の参考情報となる選択肢が公表されているとされています。' },
  { q: 'エージェントはどう選ぶべき？', a: '経営企画求人を扱うエージェントとして、コンサル特化型・ハイクラス型の選択肢が公表されているとされています。' }
];
