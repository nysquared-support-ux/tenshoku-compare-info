---
/**
 * consul-up-or-out LP (MyVision 転職・★326 DRY engineer-30dai pattern)
 * ★480 MyVision a8mat verbatim (4B3SN7+KU6YA+5B0Y+5ZU29 / banner 4B3SN7+KU6YA+5B0Y+5ZU29)
 * メイン KW: コンサル up or out 転職
 * ★326 DRY 流用元: engineer-30dai-tenshoku / 2026-05-24 [新セッション継承] 3ASP×Batch
 */
import RichLayout from '../../layouts/RichLayout.astro';

const A8 = 'https://px.a8.net/svt/ejp?a8mat=4B3SN7+KU6YA+5B0Y+5ZU29';
const title = 'コンサル Up or Out 文化と転職の完全ガイド｜昇進プレッシャーとキャリア選択｜MyVision (PR)';
const description = 'コンサル Up or Out 文化と転職を、ファーム別実態・昇進プレッシャー対応・キャリア選択で整理。Up or Out 下での選択肢、転職を進める5つの対策、無料サポートの活用法を解説（PR・アフィリエイト広告を含みます）。';
