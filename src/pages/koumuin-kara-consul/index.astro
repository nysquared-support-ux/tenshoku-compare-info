          <thead><tr><th>ファーム種別</th><th>公共案件</th><th>年収レンジ目安</th><th>適合する経歴</th></tr></thead>
          <tbody>
            <tr><td>シンクタンク系 (野村総研 / 三菱総研)</td><td>&#11088; 政策提言 / 調査研究</td><td>600-2,000万円</td><td>政策立案 / 調査研究経験者</td></tr>
            <tr><td>BIG4 公共部門 (Deloitte / PwC / EY / KPMG)</td><td>公共改革 / 行政 DX</td><td>700-2,000万円</td><td>制度設計 / 公共調達経験者</td></tr>
            <tr><td>アクセンチュア 公共サービス本部</td><td>行政 DX / システム改革</td><td>650-1,800万円</td><td>公共 IT / DX 推進経験者</td></tr>
            <tr><td>NTT データ経営研究所</td><td>公共政策 / 社会システム</td><td>600-1,600万円</td><td>政策 / 社会システム経験者</td></tr>
            <tr><td>総合系 (ベイカレント等)</td><td>公共 + 民間横断案件</td><td>700-2,200万円</td><td>幅広い行政経験者</td></tr>
          </tbody>
        </table>
      </div>

      <div style="text-align:center;margin:2rem 0;">
        <a href="https://px.a8.net/svt/ejp?a8mat=4B3SN7+KU6YA+5B0Y+5ZU29&sitemicros=banner_koumuin_middle" rel="sponsored nofollow noopener" target="_blank" referrerpolicy="no-referrer-when-downgrade">
          <img border="0" width="300" height="250" src="https://www27.a8.net/svt/bgt?aid=260517571035&wid=001&eno=01&mid=s00000024757001007000&mc=1" alt="コンサル特化転職エージェント MyVision (PR)" loading="lazy" style="max-width:100%;height:auto;" />
