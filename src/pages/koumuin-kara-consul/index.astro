/**
 * koumuin-kara-consul LP (MyVision コンサル特化・★326 DRY)
 * ★480 a8mat 4B3SN7+KU6YA+5B0Y+5ZU29 verbatim
 * メイン KW: 公務員からコンサル (sv 推定 300-500・官公庁出身者業界転身)
 */
import RichLayout from '../../layouts/RichLayout.astro';

const A8 = 'https://px.a8.net/svt/ejp?a8mat=4B3SN7+KU6YA+5B0Y+5ZU29';
const title = '公務員からコンサル 完全ガイド｜官公庁・自治体出身者が狙う公共系コンサルのキャリアパス｜MyVision (PR)';
const description = '公務員 (国家公務員・地方公務員・官公庁) からコンサル業界へ転職するための完全ガイド。狙える公共系コンサルファーム・年収レンジ・行政知見が評価される5領域・選考対策を公開情報ベースで整理。元コンサル無料カウンセリング活用法を解説 (PR・アフィリエイト広告を含みます)。';
const breadcrumb = [
  { name: 'ホーム', url: '/' },
  { name: 'コンサル転職ガイド', url: '/' },
  { name: '公務員からコンサル' },
];
const articleSchema = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  datePublished: '2026-05-21', dateModified: '2026-05-21',
  author: { '@type': 'Organization', name: 'NY-squared 編集部' },
  publisher: { '@type': 'Organization', name: 'NY-squared 編集部', url: 'https://tenshoku-compare-info.pages.dev/' },
};
const faq = [
  { q: '公務員からコンサルに転職できますか?', a: 'コンサル特化エージェントの公開情報によれば、官公庁・自治体出身者は公共系コンサル (野村総研・三菱総研・PwC 公共部門等) のメインターゲット層の一つとされています。行政知見 + 政策理解 + 公共調達知見が評価される傾向です。' },
  { q: '公務員からコンサルへの年収はどう変わりますか?', a: '一般公開情報によれば、公務員 (30代) 平均 550-750万円 → 公共系コンサル入社 600-1,000万円帯への移行事例が報告されています。経験 + ポジションにより変動します。詳細は <a href="/consul-nensyu/" class="underline">コンサル年収ガイド</a> 参照。' },
  { q: '公務員出身者が狙えるファームは?', a: '一般公開情報によれば、公共系コンサル (野村総研・三菱総研・NTT データ経営研究所等) + BIG4 の公共部門 + アクセンチュア公共サービス本部等が官公庁出身者の主要転職先とされています。詳細は <a href="/nri-tenshoku/" class="underline">野村総研 転職</a> 参照。' },
  { q: '行政知見はコンサルでどう評価されますか?', a: '一般的に政策立案 + 公共調達 + 法規制理解 + ステークホルダー調整経験は、公共系コンサル案件で高く評価される傾向とされています。「政策の現場経験」が民間コンサルにない強みとされる傾向です。' },
  { q: 'ケース面接対策は公務員出身者でも必要ですか?', a: 'はい、年齢 + 経歴に関わらず、コンサル選考ではケース面接が大きな関門とされています。公共系コンサルでは政策課題系のケースも頻出とされる傾向です。詳細は <a href="/consul-case-mensetsu/" class="underline">ケース面接対策</a> 参照。' },
  { q: '公務員からコンサルへの転職で注意点は?', a: '一般的に「安定性 → 成果主義」「行政文化 → コンサル文化」のギャップへの適応 + 民間視点 (収益性 / スピード感) の獲得が課題とされる傾向です。元コンサルからの実態ヒアリング + キャリア相談が推奨されます。' },
];
const faqSchema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faq.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const breadcrumbSchema = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: breadcrumb.map((b, i) => ({
    '@type': 'ListItem', position: i + 1, name: b.name,
    ...(b.url ? { item: 'https://tenshoku-compare-info.pages.dev' + b.url } : {}),
  })),
};
---

<RichLayout title={title} description={description} breadcrumb={breadcrumb}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
  </Fragment>

  <section class="fv" aria-labelledby="fv-h1">
    <div class="container">
      <span class="fv-pill">公務員 → コンサル / 業界転身完全ガイド</span>
      <h1 id="fv-h1"><span class="accent">公務員からコンサル</span> 完全ガイド<br />官公庁・自治体出身者が狙う公共系コンサルのキャリアパス</h1>
      <p class="lede"><strong>結論 (一般的傾向)</strong>: 公務員 (国家公務員・地方公務員・官公庁) 出身者は<strong>公共系コンサルのメインターゲット層の一つ</strong>とされ、行政知見 + 政策理解 + 公共調達知見が評価される傾向です。本記事では公務員からコンサルへの転身を、狙えるファーム + 年収レンジ + 評価される 5 領域 + 選考対策で公開情報ベースに整理します。※ 以下はすべて公開情報・業界一般論ベースの整理であり、断定的結論ではありません。</p>
      <ul class="fv-bullets">
        <li>公務員出身者が評価される 5 領域</li>
        <li>狙える公共系コンサルファーム + 年収レンジ</li>
        <li>行政文化 → コンサル文化への適応ポイント</li>
        <li>選考対策 + 元コンサル無料サポート活用</li>
      </ul>
      <div class="cta-block">
        <p class="cta-note"><span class="pr-tag">PR</span>A8.net 経由のアフィリエイトリンクです。クリックしても利用者の費用負担は生じません。</p>
        <a class="btn-cta" href={`${A8}&sitemicros=fv_koumuin`} rel="sponsored nofollow noopener" target="_blank" referrerpolicy="no-referrer-when-downgrade" data-cta="fv_koumuin">
          <span>公務員出身者向け無料カウンセリングを予約する (会員登録30秒)</span>
          <span class="arrow" aria-hidden="true">&rarr;</span>
        </a>
        <p class="btn-cta-sub">※ 本ページはアフィリエイト広告（PR）を含みます。本サイトは転職エージェント公式サイトではなく、公開情報を整理した一般論ベースの情報提供サイトです。本記事は転職効果・年収アップ・成功保証ではなく、個別キャリア相談は必ずエージェント・キャリアコンサルタントにご相談ください。</p>
      </div>
      <div class="fv-meta">
        <span><b>公開日</b> 2026-05-21</span>
        <span><b>最終更新</b> 2026-05-21</span>
        <span><b>編集</b> NY-squared 編集部</span>
        <span><b>所要</b> 約 10 分</span>
      </div>
    </div>
  </section>

  <section class="lp-section" id="sec-1" aria-labelledby="h2-1">
    <div class="container">
      <p class="section-num">SECTION / 01</p>
      <h2 id="h2-1">公務員出身者が評価される 5 領域</h2>
      <p class="section-lede">本記事の主張根拠 (出典): コンサル特化エージェント公開情報 / <a href="https://www.jil.go.jp/" target="_blank" rel="noopener">JILPT 労働政策研究・研修機構</a> / 公共系コンサルファーム公式キャリアサイト。本サイトの編集方針は <a href="/editorial-policy/" class="underline">編集ポリシー</a>・個人情報の取り扱いは <a href="/privacy-policy/" class="underline">プライバシーポリシー</a>・運営者情報は <a href="/about/" class="underline">運営者情報・特商法表記</a> をご確認ください。</p>
      <div class="counter-box">
        <h4>領域1: 政策立案 + 制度設計</h4>
        <p>官公庁での政策立案 + 制度設計 + 法令・規制整備の経験。公共系コンサルの政策提言案件で中核評価軸とされています。</p>
      </div>
      <div class="counter-box">
        <h4>領域2: 公共調達 + プロジェクト管理</h4>
        <p>公共事業の調達 + 予算管理 + プロジェクト推進経験。公共セクター向けコンサル案件で活きる実務知見とされる傾向です。</p>
      </div>
      <div class="counter-box">
        <h4>領域3: ステークホルダー調整</h4>
        <p>多様な利害関係者 (省庁 / 自治体 / 民間 / 住民) の調整経験。コンサルの複雑な案件推進で評価される能力とされています。</p>
      </div>
      <div class="counter-box">
        <h4>領域4: 行政知見 + 法規制理解</h4>
        <p>行政手続き + 法規制 + 公共政策の深い理解。規制対応 + 公共 DX 案件で民間出身者にない強みとされる傾向です。</p>
      </div>
      <div class="counter-box">
        <h4>領域5: 文書作成 + 論理構成力</h4>
        <p>官公庁での文書作成 + 答弁資料 + 政策説明資料の作成経験。論理的な文書構成力はコンサルの資料作成で活きるとされる傾向です。</p>
      </div>
      <div class="cta-block tight">
