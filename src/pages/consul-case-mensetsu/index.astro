import RichLayout from '../../layouts/RichLayout.astro';

const A8 = 'https://px.a8.net/svt/ejp?a8mat=4B3SN7+KU6YA+5B0Y+5ZU29';
const title = 'コンサル ケース面接対策 完全ガイド｜頻出5タイプ + 解法フレームワーク + 4週間ロードマップ｜MyVision (PR)';
const description = 'コンサル選考の最大の関門であるケース面接対策を、頻出問題5タイプ (フェルミ推定・市場規模・収益改善・市場参入・新規事業) + 解法フレームワーク (MECE/イシューツリー/仮説思考) + 4週間トレーニングロードマップで整理。元コンサルとの模擬面接 + 添削が無料で受けられるMyVisionの活用法を解説 (PR・アフィリエイト広告を含みます)。';
const breadcrumb = [
