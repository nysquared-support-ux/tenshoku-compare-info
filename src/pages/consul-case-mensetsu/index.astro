const faq = [
  { q: 'コンサルティングファームのケース面接では、具体的にどのような能力が評価されるのでしょうか？', a: 'ケース面接では、論理的思考力、問題解決能力、コミュニケーション能力などが総合的に評価されるとされます。厚生労働省の職業情報提供サイト（jobtag）においても、経営コンサルタントには「課題分析力」や「企画・提案力」が不可欠なスキルとして挙げられており、これらの能力を実際の課題解決プロセスを通じて示せるかが重要です。' },
  { q: 'ケース面接対策は、具体的にいつから、どのくらいの期間始めるのが一般的ですか？', a: '一般的には、選考開始の1〜2ヶ月前から対策を始める方が多いとされます。本記事で提案する4週間ロードマップのように、最初の1〜2週間で基礎的なフレームワークを学び、残りの2〜3週間で実践的な問題演習や模擬面接を重ねるのが効率的な進め方の一つとして考えられます。計画的に進めることが通過の可能性を高めます。' },
  { q: 'フェルミ推定とビジネスケース問題の違いがよくわかりません。対策方法は異なりますか？', a: 'フェルミ推定は「日本の電柱の数は？」といった未知の数値を論理的に概算する問題です。一方、ビジネスケースは「ある企業の売上向上策は？」といった、より複雑な経営課題を扱います。対策としては、まずフェルミ推定で思考の基礎体力を養い、その後ビジネスケースでより複合的な分析力を鍛えるのが効果的とされます。' },
  { q: 'ケース面接でやってはいけない、避けるべき「NG回答」はありますか？', a: '前提確認を怠り、いきなり結論に飛びつくこと、非現実的な施策を提案すること、面接官との対話を無視して一方的に話し続けることなどは避けるべきとされます。思考のプロセスを丁寧に説明し、面接官と議論を深める姿勢が重要です。沈黙が長くなりすぎるのも、コミュニケーション能力を疑われる可能性があるため注意が必要です。' },
  { q: '独学だけでコンサルファームのケース面接を突破することは可能でしょうか？', a: '書籍やWebサイトを活用した独学も有効ですが、思考の癖や論理の飛躍は自分では気づきにくいとされます。元コンサルタントなど第三者からの客観的なフィードバックを受けることで、思考の質を飛躍的に高めることが期待できます。模擬面接サービスなどを活用し、実践的な対話形式の練習を積むことが推奨されます。' },
];
const faqSchema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faq.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
