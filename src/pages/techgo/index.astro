---
/**
 * TechGo エージェント解説 LP (TechGo・Claude Design techgo 完全 class 構造準拠・★503 playbook Part A)
 * ★326 DRY engineer-1000man rich-v3 テンプレ流用・既存テキスト保持
 * ★441-EXT/★452: JSON-LD 2種 (Article/FAQPage) を RichLayout slot="head" で保持
 * ASP: TechGo a8mat=4B1LPN+E39C6Q+5B0Y+HV7V6 (★480 critical-urls.md L458 照合済)
 * ★327 backup: backups/2026-05-17-techgo-before-rich/
 */
import RichLayout from '../../layouts/RichLayout.astro';

const A8 = 'https://px.a8.net/svt/ejp?a8mat=4B1LPN+E39C6Q+5B0Y+HV7V6';
const title = 'TechGo｜ITエンジニア向け転職エージェント徹底解説 (公開情報)';
const description = 'TechGo (テックゴー) はITエンジニアハイクラス層向けの転職エージェント。公開情報をもとに対象者・サポート内容・利用の流れを整理。';
const breadcrumb = [
  { name: 'ホーム', url: '/' },
  { name: 'IT エンジニア転職', url: '/high-class/' },
  { name: 'TechGo 解説' },
];

const articleSchema = {
  '@context': 'https://schema.org', '@type': 'Article', 'headline': title, 'description': description,
  'datePublished': '2026-04-25', 'dateModified': '2026-05-05',
  'author': { '@type': 'Organization', 'name': 'NY-squared', 'url': 'https://nysquared.com/' },
  'publisher': { '@type': 'Organization', 'name': 'NY-squared' },
  'articleSection': '転職エージェント比較', 'about': 'TechGo (IT エンジニア向け転職エージェント)',
};
const faq = [
  { q: '利用料金はかかりますか?', a: '転職エージェントの一般的な慣行として、求職者側の利用料は無料の場合が多いです。正確な条件は公式サイトの利用規約・FAQ をご確認ください。' },
  { q: '紹介された求人を断れますか?', a: '多くのエージェントでは紹介求人への応募は強制ではありません。希望と異なれば見送ることができるのが一般的です。' },
  { q: '退会は可能ですか?', a: '退会・サービス停止は可能です。具体的な手続きは公式サイトのプライバシーポリシー・利用規約をご確認ください。' },
  { q: '経験年数が浅くても利用できますか?', a: 'IT 系のエージェントは経験年数に応じた求人提案を行うことが一般的とされています。第二新卒〜実務 3 年未満でも対応可能なケースが多く、無料カウンセリング時に経験・スキルを正直に伝達することで適切な求人提案が期待できます。' },
  { q: '技術スタックの希望は反映されますか?', a: 'IT 特化型エージェントは技術スタック (言語/フレームワーク/インフラ) を踏まえたマッチングを実施するのが一般的です。フロントエンド (React/Vue)・バックエンド (Go/Rust/Python/Java)・インフラ (AWS/GCP/Kubernetes)・モバイル (iOS/Android) 等の希望を初回面談で明示することが推奨されます。' },
  { q: '在職中でも面談はオンラインで可能ですか?', a: '多くの IT 特化型エージェントが Zoom や Google Meet 等のオンライン面談に対応しています。地方在住者・在職中の方でも平日夜間や土日に面談を設定できるケースが一般的とされています。' },
  { q: '年収交渉のサポートはありますか?', a: 'IT 特化型エージェントは技術職の市場相場を熟知しており、年収交渉の代行サポートが一般的とされています。希望年収レンジを事前に明示することで、現年収 + 10-30% 程度のアップを目標とした交渉が期待できます。' },
];
const faqSchema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  'mainEntity': faq.map(f => ({ '@type': 'Question', 'name': f.q, 'acceptedAnswer': { '@type': 'Answer', 'text': f.a } })),
};
---

<RichLayout title={title} description={description} breadcrumb={breadcrumb}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
  </Fragment>

  <!-- ============ FV ============ -->
  <section class="fv" aria-labelledby="fv-h1">
    <div class="container">
      <span class="fv-pill">TechGo / IT エンジニア向け転職エージェント解説</span>
      <h1 id="fv-h1">
        <span class="accent">TechGo</span>｜IT エンジニア向け<br />
        転職エージェント徹底解説 (公開情報)
      </h1>
      <p class="lede">
        TechGo (テックゴー) は IT エンジニアハイクラス層向けに特化した転職エージェントとして公式サイトで案内されています。経験者・管理職・スペシャリスト向けの非公開求人を扱うとされており、IT 業界出身のキャリアアドバイザーが在籍しているのが特徴です。本ページは公開情報を整理した解説ページであり、公式サイトではありません。
      </p>
      <ul class="fv-bullets">
        <li>TechGo の特徴・主な対象者を公開情報で整理</li>
        <li>サポート内容の概要・利用の流れを体系化</li>
        <li>30-50 代男性が利用検討する際のポイント 3 点</li>
        <li>厚労省・総務省統計局・JILPT・IPA 出典明示</li>
      </ul>
      <div class="cta-block">
        <p class="cta-note"><span class="pr-tag">PR</span>A8.net 経由のアフィリエイトリンクです。クリックしても利用者の費用負担は生じません。本サイト経由でリンク先 TechGo 公式へお申込みが成立した場合、運営者は提携先 (A8.net) より報酬を受け取ります。</p>
        <a class="btn-cta" href={`${A8}&sitemicros=hub_fv`} rel="sponsored nofollow noopener" target="_blank" referrerpolicy="no-referrer-when-downgrade" data-cta="hub_fv">
          <span>TechGo 公式サイトで無料カウンセリング詳細を見る</span>
          <span class="arrow" aria-hidden="true">→</span>
        </a>
        <p class="btn-cta-sub">※ 公式サイトに遷移します。本サイトは TechGo 公式サイトではありません。順位・推奨は公開情報・公式の専門性表記に基づくものであり、報酬額により内容を変えることはしていません。</p>
      </div>
      <div class="fv-meta">
        <span><b>公開日</b> 2026-04-25</span>
        <span><b>最終更新</b> 2026-05-05</span>
        <span><b>編集</b> NY-squared 編集部</span>
        <span><b>所要</b> 約 5 分</span>
      </div>
    </div>
  </section>

  <!-- ============ SECTION 01 特徴 + 対象者 ============ -->
  <section class="lp-section" id="sec-1" aria-labelledby="h2-1">
    <div class="container">
      <p class="section-num">SECTION / 01</p>
      <h2 id="h2-1">TechGo の特徴と主な対象者 (公開情報ベース)</h2>
      <p class="section-lede">TechGo は IT エンジニアハイクラス層向け特化エージェントとして以下が公式サイトで案内されています。</p>

      <div class="branch-grid">
        <article class="branch">
          <span class="tag">特徴</span>
          <h4>ハイクラス特化 + 業界経験者</h4>
          <p>経験者・管理職・スペシャリスト向け非公開求人。IT 業界出身のキャリアアドバイザー在籍。</p>
        </article>
        <article class="branch">
          <span class="tag">対象 1</span>
          <h4>IT 業界経験者</h4>
          <p>エンジニア・PM・PdM・IT コンサル等。</p>
        </article>
        <article class="branch">
          <span class="tag">対象 2</span>
          <h4>ハイクラス層</h4>
          <p>年収レンジは公式サイトで確認推奨。30-50 代のキャリアアップ志望者。</p>
        </article>
        <article class="branch">
          <span class="tag">対象 3</span>
          <h4>マネジメント経験者</h4>
          <p>マネジメント経験を活かしたい方。</p>
        </article>
      </div>

      <p class="compare-note">※ 記載内容は 2026-04-25 時点。最新情報は公式サイトでご確認ください。本記事は厚生労働省・総務省統計局・JILPT・IPA・TechGo 公式サイトの公開情報を整理した一般論であり、断定的事実ではありません。転職結果は個別状況により異なります。</p>

      <div class="cta-block tight">
        <a class="btn-cta" href={`${A8}&sitemicros=hub_features`} rel="sponsored nofollow noopener" target="_blank" referrerpolicy="no-referrer-when-downgrade" data-cta="hub_features">
          <span>特徴を踏まえ TechGo 公式サイトで詳細を確認する</span>
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ============ SECTION 02 サポート内容 + 利用の流れ ============ -->
  <section class="lp-section alt" id="sec-2" aria-labelledby="h2-2">
    <div class="container">
      <p class="section-num">SECTION / 02</p>
      <h2 id="h2-2">サポート内容の概要と利用の流れ</h2>
      <p class="section-lede">サポート内容 + 一般的なエージェント利用フローを整理します。詳細なサポート範囲は公式サイトでご確認ください。</p>
      <div class="card-grid">
        <div class="card">
          <h3>サポート内容の概要 (公開情報)</h3>
          <p>キャリア相談 (業界経験者がヒアリング) / 非公開求人の紹介 / 書類添削・面接対策 / 年収交渉の代行 / 入社後のフォローアップ</p>
        </div>
        <div class="card">
          <h3>利用の流れ (一般的なエージェント利用フロー)</h3>
          <p>① 公式サイトから無料登録 (キャリア情報・希望条件を入力) / ② キャリアアドバイザーとの初回面談 (オンライン対応) / ③ 非公開求人の紹介を受ける / ④ 応募・書類選考・面接 / ⑤ 内定・条件交渉・入社</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ SECTION 03 利用検討ポイント ============ -->
  <section class="lp-section" id="sec-3" aria-labelledby="h2-3">
    <div class="container">
      <p class="section-num">SECTION / 03</p>
      <h2 id="h2-3">30-50 代男性が利用を検討する際のポイント</h2>
      <div class="compare-wrap">
        <table class="compare" aria-label="TechGo 利用検討ポイント">
          <thead><tr><th>ポイント</th><th>内容 (公開情報整理)</th></tr></thead>
          <tbody>
            <tr><td>ハイクラス層中心の求人傾向</td><td>未経験者や若手向け求人は少ない可能性。経験 5 年以上・年収レンジ一定以上の方が登録対象として想定されているとみられる</td></tr>
            <tr><td>IT 業界経験者の担当者と話せる</td><td>公式サイトで業界経験者の在籍が訴求。技術用語が通じる担当者と話したい方には合致しやすい特徴</td></tr>
            <tr><td>在職中の利用</td><td>多くの転職エージェントと同様、在職中の利用に対応していると一般的に想定。具体的な面談時間帯 (夜間・週末対応) は初回登録時に確認推奨</td></tr>
          </tbody>
        </table>
      </div>
      <p class="compare-note">※ 公開情報を整理した一般的傾向であり、利用結果は個別状況により異なります。</p>
      <div class="cta-block tight">
        <a class="btn-cta" href={`${A8}&sitemicros=hub_salary`} rel="sponsored nofollow noopener" target="_blank" referrerpolicy="no-referrer-when-downgrade" data-cta="hub_salary">
          <span>利用検討ポイントを踏まえ TechGo 公式サイトを確認する</span>
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ============ SECTION 04 まとめ + 利用が向く人 ============ -->
  <section class="lp-section alt" id="sec-4" aria-labelledby="h2-4">
    <div class="container">
      <p class="section-num">SECTION / 04</p>
      <h2 id="h2-4">まとめ｜利用が向く人と行動 3 ステップ</h2>
      <div class="counter-box">
        <h3>📌 TechGo の利用が向く人 (公開情報整理)</h3>
        <div class="row"><b>IT/Web 系の専門職</b><span>エンジニア/SRE/データサイエンティスト等</span></div>
        <div class="row"><b>技術スタックを軸に転職したい</b><span>言語/フレームワーク/インフラ重視</span></div>
        <div class="row"><b>30 代以降のキャリアアップ転職</b><span>テックリード/EM/CTO 候補</span></div>
        <div class="row"><b>在職中の活動希望</b><span>オンライン面談 + 平日夜間/土日対応</span></div>
        <p style="margin-top:12px;font-size:13px;color:var(--c-text-sub);">※ TechGo は IT/エンジニア特化型で技術スタック・プロジェクト規模・キャリアパスを熟知したアドバイザーが伴走するのが一般的。料金は転職希望者は無料 (求人掲載企業から成功報酬) で複数併用にコストリスクなし。行動 3 ステップ: ① 希望条件 (技術スタック/年収/働き方/業界) を整理 ② TechGo 公式サイトで無料登録 + プロフィール詳細記載 (技術スタック・実績数値必須) ③ 初回面談で対応品質・求人の質を確認・他エージェント 1-2 社と併用判断。<br /><strong>YMYL リスク認識</strong>: 年収・キャリアは就業判断に直結。本記事は転職保証・年収アップ保証・効果保証ではなく、特定エージェントを推奨するものでもありません。</p>
      </div>

      <div class="cta-block">
        <a class="btn-cta" href={`${A8}&sitemicros=hub_final`} rel="sponsored nofollow noopener" target="_blank" referrerpolicy="no-referrer-when-downgrade" data-cta="hub_final">
          <span>最新のサービス内容は TechGo 公式サイトで確認する</span>
          <span class="arrow" aria-hidden="true">→</span>
        </a>
        <p class="btn-cta-sub">※ 本記事は 2026 年 5 月時点の公開情報をもとに作成。最新の対象範囲・サポート内容は TechGo 公式サイトで必ずご確認ください。具体的な利用判断は無料登録・初回面談を活用し複数エージェントを比較した上でご自身の責任において選択してください。</p>
      </div>
    </div>
  </section>

  <!-- ============ SECTION 05 FAQ + 関連記事 ============ -->
  <section class="lp-section" id="sec-5" aria-labelledby="h2-5">
    <div class="container">
      <p class="section-num">SECTION / 05</p>
      <h2 id="h2-5">よくある質問・関連記事</h2>
      {faq.map((item) => (
        <div class="faq">
          <details>
            <summary>{item.q}</summary>
            <div>{item.a}</div>
          </details>
        </div>
      ))}
      <div class="card-grid">
        <div class="card">
          <h3>関連 Spoke LP・他エージェント</h3>
          <p>
            <a href="/osusume/">転職エージェント Hub</a> /
            <a href="/myvision/">MyVision (コンサル業界専門)</a> /
            <a href="/unizon-it/">ユニゾンキャリア (IT・Web)</a> /
            <a href="/mensetsu/">転職面接 自己紹介</a> /
            <a href="/30dai/">30 代向けエージェント比較</a> /
            <a href="/40dai-koukai/">40 代後悔回避ページ</a>
          </p>
        </div>
        <div class="card">
          <h3>公的相談窓口・支援機関</h3>
          <p>
            <a href="https://www.mhlw.go.jp/" target="_blank" rel="noopener">厚生労働省</a> — 労働市場分析・IT 人材需給 /
            <a href="https://www.stat.go.jp/" target="_blank" rel="noopener">総務省統計局</a> — IT 労働者の年収分布 /
            <a href="https://www.jil.go.jp/" target="_blank" rel="noopener">JILPT</a> — IT 業界転職動向 /
            <a href="https://www.ipa.go.jp/" target="_blank" rel="noopener">IPA</a> — IT 人材白書
          </p>
        </div>
      </div>
      <p class="compare-note">※ 本記事は 2026 年 5 月時点の公開情報をもとに作成。最新の対象範囲・サポート内容は TechGo 公式サイトで必ずご確認ください。運営: <a href="/operator-info/">NY-squared (個人事業)</a> / <a href="/editorial-policy/">編集ポリシー</a> / <a href="/privacy-policy/">プライバシーポリシー</a>。本記事は転職保証・年収アップ保証・効果保証ではなく、特定エージェントを推奨するものでもありません。</p>
    </div>
  </section>
</RichLayout>
