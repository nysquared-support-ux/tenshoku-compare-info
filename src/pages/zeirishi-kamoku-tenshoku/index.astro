  'description': '税理士科目合格者・会計事務所スタッフ向け転職エージェント 4 社の公開情報整理',
  'itemListOrder': 'https://schema.org/ItemListUnordered',
  'itemListElement': [
    {'@type': 'ListItem', 'position': 1, 'item': {'@type': 'Service', 'name': 'ツインプロ', 'serviceType': '会計士・税理士特化 転職エージェント', 'description': '士業有資格者・科目合格者特化・無料キャリア面談・年収アップ実績', 'provider': {'@type': 'Organization', 'name': 'MyVision 株式会社'}}},
    {'@type': 'ListItem', 'position': 2, 'item': {'@type': 'Service', 'name': 'マイナビ会計士', 'serviceType': '会計士・税理士特化 転職エージェント', 'description': '税理士・会計士特化・大手系列・若手中堅対応', 'provider': {'@type': 'Organization', 'name': '株式会社マイナビ'}}},
    {'@type': 'ListItem', 'position': 3, 'item': {'@type': 'Service', 'name': 'MS-Japan', 'serviceType': '管理部門特化 転職エージェント', 'description': '経理・財務・税理士・科目合格者向け・事業会社経理転職に強み', 'provider': {'@type': 'Organization', 'name': '株式会社 MS-Japan'}}},
    {'@type': 'ListItem', 'position': 4, 'item': {'@type': 'Service', 'name': 'リクルートエージェント', 'serviceType': '総合型転職エージェント (士業含む)', 'description': '求人数 60 万件以上・税理士・経理求人もカバー・併用推奨', 'provider': {'@type': 'Organization', 'name': '株式会社リクルート'}}},
