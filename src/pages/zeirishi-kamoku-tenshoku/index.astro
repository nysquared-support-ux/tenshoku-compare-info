const faq = [
  { q: '税理士の科目合格は1科目でも転職で評価されますか?', a: '公開情報上、税理士科目合格は1科目からでも「会計・税務知識を持つ人材」とみなされ評価されるとされています。特に簿記論・財務諸表論・法人税法は会計事務所・税理士法人・事業会社経理で需要が高いとされています。但し採用可否・評価程度は採用企業・時期・経験により異なります。詳細は各エージェントのキャリア面談でご確認ください。' },
  { q: '科目合格者が特に評価される転職先はどこですか?', a: '公開情報上、①会計事務所・中小税理士法人 (即戦力として採用されやすい) ②事業会社の経理・財務部門 (簿記論・法人税法が特に評価) ③Big4・大手税理士法人 (複数科目合格 + 実務経験で評価幅が広がる) の3タイプが代表的とされています。個別判断はエージェント相談が推奨されます。' },
  { q: '法人税法合格は転職でどれくらい有利ですか?', a: '公開情報上、法人税法は税法科目の中で最難関かつ実務需要が最も高い科目とされ、会計事務所・税理士法人・企業経理・コンサルファームで「即戦力」として評価されやすいとされています。但し合格1科目だけでなく実務経験との組み合わせで評価が変わるとされています。' },
  { q: '税理士科目合格者の年収相場はどのくらいですか?', a: '公開情報上、厚生労働省「賃金構造基本統計調査(令和6年)」では税理士の平均年収は856.3万円とされています。科目合格段階では会計事務所スタッフとして350〜500万円程度が一般的とされていますが、合格科目数・実務経験・転職先タイプにより大きく異なります。年収見込みは各エージェント相談を推奨します。' },
  { q: '在職中でも転職活動を進められますか?', a: '公開情報上、多くの転職エージェントは在職中の相談・求人紹介を受け付けているとされています。ツインプロ等も無料キャリア面談をオンラインで提供しているとされています。在職中相談可・退会自由が一般的な利用規約とされています。繁忙期 (1〜3月確定申告期) 以外のタイミングが活動しやすいとされています。' },
  { q: '科目合格者に向く転職タイミングはいつですか?', a: '公開情報上、税理士業界の転職活発期は ①繁忙期前 (4〜5月) ②期末後 (7〜9月) ③採用強化期 (10〜12月) の3タイミングとされています。科目試験合格発表後 (12〜1月) のタイミングも合格実績を活かした転職活動に適しているとされています。但し個別事情により最適時期は異なります。' },
  { q: '会計事務所から税理士法人 (Big4) へのステップアップは可能ですか?', a: '公開情報上、中小会計事務所からBig4・大手税理士法人へのステップアップは複数科目合格 + 実務経験の組み合わせで可能とされているケースがあります。特に法人税法・消費税法合格 + 2〜3年の実務経験が評価されやすいとされています。詳細は士業特化エージェントへご相談ください。' },
  { q: '士業特化エージェントと総合型エージェントの違いは?', a: '公開情報上、士業特化エージェントは ①担当者の税務・会計業界知見が深い ②税理士法人・会計事務所の非公開求人へのアクセス ③業界相場を踏まえた年収交渉、の3点が強みとされています。一方、総合型は求人数の多さ・事業会社経理を幅広くカバーする強みがあります。両者の併用が推奨されます。' },
  { q: 'ツインプロは科目合格者も対応していますか?', a: '公開情報上、ツインプロは会計士・税理士などの士業有資格者・科目合格者を対象とした転職エージェントとされています。簿記資格者も対象とされています。詳細な対応範囲・対象条件は公式サイトへご確認ください。' },
  { q: '複数エージェントに同時登録しても問題ありませんか?', a: '公開情報上、複数エージェントへの同時登録は一般的な利用方法とされており、2〜3社並行登録で求人の比較・担当者との相性確認ができるとされています。但し同一求人への重複応募は避けるよう、各エージェントと確認することが推奨されます。' },
];

const faqSchema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  'mainEntity': faq.map(f => ({ '@type': 'Question', 'name': f.q, 'acceptedAnswer': { '@type': 'Answer', 'text': f.a } })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  'itemListElement': breadcrumb.map((b, i) => ({
    '@type': 'ListItem', 'position': i + 1,
    'name': b.name,
    ...(b.url ? { 'item': `https://tenshoku-compare-info.pages.dev${b.url}` } : {}),
  })),
};
