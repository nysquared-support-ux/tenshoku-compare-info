const breadcrumb = [
  { name: 'ホーム', url: '/' },
  { name: '転職エージェント', url: '/osusume/' },
  { name: '会計士M&A転職' },
];

const itemListSchema = {
  '@context': 'https://schema.org', '@type': 'ItemList',
  'name': '会計士・M&A領域志望者向け転職エージェント主要 4 サービス比較',
  'description': '公認会計士がM&A領域 (FAS・M&Aアドバイザリー) を目指す層向け転職エージェント 4 社の公開情報整理',
  'itemListOrder': 'https://schema.org/ItemListUnordered',
  'itemListElement': [
    {'@type': 'ListItem', 'position': 1, 'item': {'@type': 'Service', 'name': 'ツインプロ', 'serviceType': '会計士・税理士特化 転職エージェント', 'description': '士業有資格者特化・FAS/M&A領域の求人・無料キャリア面談', 'provider': {'@type': 'Organization', 'name': 'MyVision 株式会社'}}},
    {'@type': 'ListItem', 'position': 2, 'item': {'@type': 'Service', 'name': 'マイナビ会計士', 'serviceType': '会計士・税理士特化 転職エージェント', 'description': '公認会計士特化・大手系列・FAS/コンサル領域対応', 'provider': {'@type': 'Organization', 'name': '株式会社マイナビ'}}},
    {'@type': 'ListItem', 'position': 3, 'item': {'@type': 'Service', 'name': 'MS-Japan', 'serviceType': '管理部門・士業特化 転職エージェント', 'description': '会計士・財務・FAS領域の転職に強み', 'provider': {'@type': 'Organization', 'name': '株式会社 MS-Japan'}}},
