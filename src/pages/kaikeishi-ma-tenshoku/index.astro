const faq = [
  { q: '公認会計士はM&A領域に転職できますか?', a: '公開情報上、公認会計士はM&A領域 (FAS・M&Aアドバイザリー等) で会計・財務の専門性を活かせる人材とみなされ、転職するケースはあるとされています。特に監査経験で培った財務分析力が財務デューデリジェンス等で評価されやすいとされています。但し採用可否は企業・時期・経験により異なり、個別判断は各エージェントのキャリア面談でご確認ください。' },
  { q: 'M&A転職で評価される会計士の経験は何ですか?', a: '公開情報上、①財務諸表の分析力 ②監査で培った検証・調査の経験 ③業種別の会計知識 ④英語力 (クロスボーダー案件) などが評価されやすいとされています。財務デューデリジェンスやバリュエーションの実務経験があるとさらに評価幅が広がるとされています。' },
  { q: 'FASとM&Aアドバイザリーの違いは何ですか?', a: '公開情報上、FAS (フィナンシャル・アドバイザリー・サービス) は財務デューデリジェンス・バリュエーション・PMI支援などM&Aの財務面を専門的に支援する領域、M&Aアドバイザリーは案件の発掘から成約までを支援する領域とされる傾向があります。会計士の専門性はFAS領域で特に活きやすいとされています。' },
  { q: '監査法人からM&A領域への転職は可能ですか?', a: '公開情報上、監査法人の会計士がFAS・M&Aアドバイザリー領域へ転職するケースは一般的に語られます。監査で培った財務分析・検証の経験が財務デューデリジェンス等で活かしやすいとされています。詳細は士業特化エージェントへご相談ください。' },
  { q: '会計士のM&A転職の年収相場はどのくらいですか?', a: '公開情報上、FAS・M&A領域の年収はファーム・役職により幅が大きく、おおむね600〜1,500万円帯で語られることが多いとされています。マネージャー以上ではさらに上の帯もあるとされます。正確な年収見込みは各エージェントのキャリア面談でご確認ください。' },
  { q: '財務デューデリジェンスの経験はどう評価されますか?', a: '公開情報上、財務デューデリジェンス (財務DD) の実務経験はFAS・M&A領域で中核的な経験として評価されやすいとされています。未経験の場合も、監査経験を財務DDに近い経験として説明できると評価につながりやすいとされています。' },
  { q: '未経験からM&A領域に行けますか?', a: '公開情報上、M&A領域未経験の会計士がFAS等へ転職するケースはあるとされています。監査経験・業種知識・分析力をM&A領域の評価軸に翻訳して伝えることが鍵とされています。詳細はエージェント相談が推奨されます。' },
  { q: '在職中でも転職活動を進められますか?', a: '公開情報上、多くの転職エージェントは在職中の相談・求人紹介を受け付けているとされています。ツインプロ等も無料キャリア面談をオンラインで提供しているとされ、在職中相談可・退会自由が一般的な利用規約とされています。' },
  { q: '複数エージェントに同時登録しても問題ありませんか?', a: '公開情報上、複数エージェントへの同時登録は一般的な利用方法とされており、2〜3社並行登録で求人の比較・担当者との相性確認ができるとされています。士業特化と総合型を組み合わせる方法が推奨されます。' },
];

const faqSchema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  'mainEntity': faq.map(f => ({ '@type': 'Question', 'name': f.q, 'acceptedAnswer': { '@type': 'Answer', 'text': f.a } })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  'itemListElement': breadcrumb.map((b, i) => ({
    '@type': 'ListItem', 'position': i + 1,
    'name': b.name,
    ...(b.url ? { 'item': `https://tenshoku-compare-info.pages.dev${b.url}` } : {}),
  })),
};
