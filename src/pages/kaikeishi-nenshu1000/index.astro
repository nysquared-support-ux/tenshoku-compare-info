---
/**
 * 会計士 年収1000万 転職おすすめ LP (ツインプロ・RichLayout 準拠)
 * ★326 DRY zeirishi-kamoku-tenshoku テンプレ流用
 * ★480 ツインプロ a8mat verbatim copy-paste (BWVTE 001 / BXB8X 003 / BXYE9 006・再入力禁止)
 * slug: kaikeishi-nenshu1000 / KW: 会計士 年収1000万
 */
import RichLayout from '../../layouts/RichLayout.astro';

const A8 = 'https://px.a8.net/svt/ejp?a8mat=4B1THX+40OCS2+5B0Y+BWVTE';
const title = '公認会計士で年収1000万を目指す転職おすすめ4社比較｜到達しやすいキャリアパスと選び方【2026年版】';
const description = '公認会計士で年収1000万円を目指す転職を検討する方向けに、転職エージェント4社 (ツインプロ・マイナビ会計士・MS-Japan・リクルート) を公開情報で整理。年収1000万に届きやすいキャリアパス・年収データ・選び方5基準が分かる(PR)。';
const breadcrumb = [
  { name: 'ホーム', url: '/' },
  { name: '転職エージェント', url: '/osusume/' },
  { name: '会計士 年収1000万 転職' },
];

const itemListSchema = {
  '@context': 'https://schema.org', '@type': 'ItemList',
  'name': '公認会計士の年収アップ転職エージェント主要 4 サービス比較',
  'description': '公認会計士・高年収帯を目指す士業人材向け転職エージェント 4 社の公開情報整理',
  'itemListOrder': 'https://schema.org/ItemListUnordered',
  'itemListElement': [
    {'@type': 'ListItem', 'position': 1, 'item': {'@type': 'Service', 'name': 'ツインプロ', 'serviceType': '会計士・税理士特化 転職エージェント', 'description': '士業有資格者特化・無料キャリア面談・年収帯を踏まえた交渉支援', 'provider': {'@type': 'Organization', 'name': 'MyVision 株式会社'}}},
    {'@type': 'ListItem', 'position': 2, 'item': {'@type': 'Service', 'name': 'マイナビ会計士', 'serviceType': '会計士・税理士特化 転職エージェント', 'description': '税理士・会計士特化・大手系列・若手中堅対応', 'provider': {'@type': 'Organization', 'name': '株式会社マイナビ'}}},
    {'@type': 'ListItem', 'position': 3, 'item': {'@type': 'Service', 'name': 'MS-Japan', 'serviceType': '管理部門特化 転職エージェント', 'description': '経理・財務・会計士向け・事業会社管理部門の高年収帯にも強み', 'provider': {'@type': 'Organization', 'name': '株式会社 MS-Japan'}}},
    {'@type': 'ListItem', 'position': 4, 'item': {'@type': 'Service', 'name': 'リクルートエージェント', 'serviceType': '総合型転職エージェント (士業含む)', 'description': '求人数 60 万件以上・会計士・経理求人もカバー・併用推奨', 'provider': {'@type': 'Organization', 'name': '株式会社リクルート'}}},
