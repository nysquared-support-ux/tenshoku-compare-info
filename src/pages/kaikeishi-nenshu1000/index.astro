};

const faq = [
  { q: '公認会計士で年収1000万円は目指せますか?', a: '公開情報上、公認会計士は監査法人のマネージャー以上・FAS・コンサルティングファーム・事業会社の経営管理職・独立など、複数のキャリアパスで年収1000万円帯に到達するケースがあるとされています。但し到達の可否・時期は経験・役職・勤務先・時期により大きく異なり、本記事は特定の年収を保証するものではありません。' },
  { q: '年収1000万に届きやすいキャリアパスはどれですか?', a: '公開情報上、①監査法人のマネージャー以上 ②FAS (財務アドバイザリー) ③コンサルティングファーム ④事業会社の経営企画・CFO 候補 ⑤独立開業 が高年収帯につながりやすいパスとして挙げられることがあります。いずれも実務経験・専門性の積み上げが前提とされ、個別の見込みはエージェント相談が推奨されます。' },
  { q: '公認会計士の平均年収はどのくらいですか?', a: '公開情報上、厚生労働省「賃金構造基本統計調査(令和6年)」では公認会計士・税理士の平均年収は856.3万円とされています。これは平均値であり、役職・勤務先・経験により上下に大きく分布します。年収1000万円帯は一定の経験・役職を前提とした水準とされています。' },
  { q: '監査法人に在籍したまま年収を上げる方法はありますか?', a: '公開情報上、監査法人内での昇進 (シニア→マネージャー→シニアマネージャー) により年収帯が上がっていくとされています。一方で、より高い年収帯やキャリアの幅を求めてFAS・コンサル・事業会社へ転職する選択肢もあり、どちらが適するかは志向により異なります。エージェントでの相談が推奨されます。' },
  { q: '年収交渉はエージェントに任せられますか?', a: '公開情報上、多くの転職エージェントは内定後の条件交渉を支援しているとされています。会計士の業界相場・役職別年収帯を踏まえた交渉知見があるエージェントを選ぶことが、適正な条件提示につながりやすいとされています。但し交渉結果を保証するものではありません。' },
  { q: '在職中でも転職活動を進められますか?', a: '公開情報上、多くの転職エージェントは在職中の相談・求人紹介を受け付けているとされています。ツインプロ等も無料キャリア面談をオンラインで提供しているとされ、在職中相談可・退会自由が一般的な利用規約とされています。監査法人の繁忙期 (期末監査期) を避けたタイミングが活動しやすいとされています。' },
  { q: '高年収求人は非公開求人が多いのですか?', a: '公開情報上、マネージャー以上・経営管理職などの高年収帯の求人は非公開求人として扱われることが多いとされています。非公開求人へのアクセスは登録したエージェント経由となるため、士業特化エージェントへの登録が選択肢を広げる一助になるとされています。' },
  { q: '士業特化エージェントと総合型エージェントの違いは?', a: '公開情報上、士業特化エージェントは ①担当者の会計業界知見が深い ②監査法人・FAS・会計事務所の非公開求人へのアクセス ③業界相場を踏まえた年収交渉、の3点が強みとされています。総合型は求人数の多さ・事業会社を幅広くカバーする強みがあり、両者の併用が推奨されます。' },
  { q: 'ツインプロは会計士の高年収転職に対応していますか?', a: '公開情報上、ツインプロは会計士・税理士などの士業有資格者を対象とした転職エージェントとされています。対応する求人帯・年収帯の詳細は公式サイトへご確認ください。' },
  { q: '複数エージェントに同時登録しても問題ありませんか?', a: '公開情報上、複数エージェントへの同時登録は一般的な利用方法とされており、2〜3社並行登録で求人の比較・担当者との相性確認ができるとされています。但し同一求人への重複応募は避けるよう、各エージェントと確認することが推奨されます。' },
];

const faqSchema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  'mainEntity': faq.map(f => ({ '@type': 'Question', 'name': f.q, 'acceptedAnswer': { '@type': 'Answer', 'text': f.a } })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  'itemListElement': breadcrumb.map((b, i) => ({
    '@type': 'ListItem', 'position': i + 1,
    'name': b.name,
    ...(b.url ? { 'item': `https://tenshoku-compare-info.pages.dev${b.url}` } : {}),
  })),
};
---

<RichLayout title={title} description={description} breadcrumb={breadcrumb}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
