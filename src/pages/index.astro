const faqSchema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  'mainEntity': [
    { '@type': 'Question', 'name': '転職エージェントの利用料金は？', 'acceptedAnswer': { '@type': 'Answer', 'text': '多くの転職エージェントは求職者側の利用料は無料です（料金は採用側企業が負担）。ただし、有料職業紹介事業の枠組みは事業者により異なるため、初回面談時に確認することが推奨されます。' } },
