/**
 * 転職 自己分析 やり方 LP (TechGo・Claude Design techgo 完全 class 構造準拠・★503 playbook Part A)
 * ★326 DRY engineer-1000man rich-v3 テンプレ流用・既存テキスト保持
 * ★441-EXT/★452: JSON-LD 3種 (Article/Breadcrumb/FAQPage) を RichLayout slot="head" で保持
 * ASP: TechGo a8mat=4B1LPN+E39C6Q+5B0Y+HV7V6 (★480 critical-urls.md L458 照合済)
 * ★327 backup: backups/2026-05-17-jiko-bunseki-before-rich/
 */
import RichLayout from '../../layouts/RichLayout.astro';

const A8 = 'https://px.a8.net/svt/ejp?a8mat=4B1LPN+E39C6Q+5B0Y+HV7V6';
const title = '転職 自己分析 やり方｜Will/Can/Must フレーム・3 ステップ進め方とおすすめツール 5 種 (2026年版・PR)';
const description = '転職活動の自己分析で何から始めればよいか迷う方へ。Will/Can/Must の 3 軸フレームワーク・自己分析の 3 ステップ進め方・無料ツール 5 種比較・職種別の深掘り例を公開情報ベースに整理した情報提供記事です (PR・アフィリエイト広告を含みます)。個別判断は各エージェントへご相談ください。';
const breadcrumb = [
  { name: 'ホーム', url: '/' },
  { name: 'IT エンジニア転職', url: '/high-class/' },
  { name: '転職 自己分析 やり方' },
];

const articleSchema = {
  '@context': 'https://schema.org', '@type': 'Article', 'headline': title, 'description': description,
  'datePublished': '2026-05-11', 'dateModified': '2026-05-11',
  'author': { '@type': 'Organization', 'name': 'NY-squared', 'url': 'https://nysquared.com/' },
  'publisher': { '@type': 'Organization', 'name': 'NY-squared' },
  'articleSection': '転職自己分析', 'about': '転職活動における自己分析のフレームワークと進め方',
};
const breadcrumbSchema = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  'itemListElement': [
    { '@type': 'ListItem', 'position': 1, 'name': 'トップ', 'item': 'https://tenshoku-compare-info.pages.dev/' },
    { '@type': 'ListItem', 'position': 2, 'name': '転職 自己分析 やり方', 'item': 'https://tenshoku-compare-info.pages.dev/jiko-bunseki/' },
  ],
};
const faq = [
  { q: '転職の自己分析は何時間くらいかかりますか?', a: '一般的に集中して 3-5 時間 (1 日かけて or 数日に分けて) が標準とされています。Will/Can/Must の 3 軸を整理する基本版は 1-2 時間、職務経歴 5 年以上のキャリア棚卸しを含む詳細版は 5-10 時間が目安とされています。' },
  { q: '自己分析と職務経歴書は同時に作るべきですか?', a: '一般的には自己分析を先に行うことが推奨されます。自己分析で「強み・価値観・志向」を整理してから職務経歴書を書くと、応募職種に合わせた強調ポイントが明確になります。両者を並行で進めるパターンも有効とされています。' },
  { q: '自己分析が苦手な人はどう進めればよいですか?', a: '一般的に「過去の出来事を時系列で書き出す → なぜそう感じたか掘り下げる → 共通パターンを抽出する」の 3 ステップが推奨されます。1 人で難しい場合は転職エージェントのキャリアアドバイザーとの面談で他者視点を入れる方法も効果的とされています。' },
  { q: 'Will/Can/Must フレームとは何ですか?', a: 'Will (やりたいこと)・Can (できること)・Must (求められること) の 3 軸で自己分析するフレームワークです。3 つが重なる領域が転職の方向性として一般的に推奨されます。Will のみで動くと現実性が欠ける、Can のみで動くと成長性が欠ける、Must のみで動くと満足度が欠ける、という構造で 3 軸統合が評価されます。' },
  { q: '自己分析で何を書き出せばよいですか?', a: '一般的に ① これまでの職務経歴と各役割での実績 ② 楽しかった/つらかったエピソード ③ 強み/弱み (他者フィードバックも含む) ④ 価値観 (働く目的・優先順位) ⑤ キャリア志向 (5 年後/10 年後の理想像) の 5 項目が推奨されます。' },
  { q: '無料の自己分析ツールはありますか?', a: '一般的にリクナビ NEXT「グッドポイント診断」・ミイダス「コンピテンシー診断」・dodaキャンパスの「キャリアタイプ診断」など各転職サービスが無料診断ツールを提供しています。複数ツール併用で結果を比較する使い方が推奨されます。' },
  { q: '転職回数が多い場合の自己分析の注意点は?', a: '一般的に「各転職での学び・成長」と「次に活かしたいスキル」を軸に整理することが推奨されます。回数を強調せず、各経験で得た強みと共通する価値観を抽出すると、応募職種への一貫性が伝わりやすくなるとされています。' },
  { q: '40 代の自己分析と 20-30 代の違いは?', a: '一般的に 40 代はマネジメント経験・業界専門性・人脈の 3 要素を中心に整理することが推奨されます。20-30 代は学習意欲・成長余地・適応力の整理が中心です。年代別の差は 40 代後悔回避ページや 40 代リベンジ転職ページも参考になります。' },
];
const faqSchema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  'mainEntity': faq.map(f => ({ '@type': 'Question', 'name': f.q, 'acceptedAnswer': { '@type': 'Answer', 'text': f.a } })),
};
---

<RichLayout title={title} description={description} breadcrumb={breadcrumb}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
  </Fragment>

  <!-- ============ FV ============ -->
  <section class="fv" aria-labelledby="fv-h1">
    <div class="container">
      <span class="fv-pill">転職 自己分析 / Will・Can・Must フレーム</span>
      <h1 id="fv-h1">
        転職 <span class="accent">自己分析 やり方</span><br />
        Will/Can/Must フレーム・3 ステップとツール 5 種
      </h1>
      <p class="lede">
        転職の自己分析は「Will (やりたいこと)・Can (できること)・Must (求められること)」の 3 軸フレームで整理することが推奨されます。基本版は 1-2 時間で完遂可能、詳細版はキャリア棚卸しを含めて 5-10 時間が目安とされています。
      </p>
      <ul class="fv-bullets">
        <li>自己分析を行う 3 つの目的を整理</li>
        <li>Will/Can/Must フレームワーク (3 軸統合)</li>
        <li>3 ステップ進め方 + 無料診断ツール 5 種比較</li>
        <li>厚労省・JILPT・国民生活センター・経産省 出典明示</li>
      </ul>
      <div class="cta-block">
        <p class="cta-note"><span class="pr-tag">PR</span>A8.net 経由のアフィリエイトリンクです。クリックしても利用者の費用負担は生じません。</p>
        <a class="btn-cta" href={`${A8}&sitemicros=hub_fv`} rel="sponsored nofollow noopener" target="_blank" referrerpolicy="no-referrer-when-downgrade" data-cta="hub_fv">
          <span>TechGo 公式サイトで無料カウンセリング詳細を見る</span>
          <span class="arrow" aria-hidden="true">→</span>
        </a>
        <p class="btn-cta-sub">※ 公式サイトに遷移します。本ページはアフィリエイトプログラム参加に基づく PR 記事です。最新の対応エリア・料金等は遷移先公式情報をご確認ください。</p>
      </div>
      <div class="fv-meta">
        <span><b>公開日</b> 2026-05-11</span>
        <span><b>最終更新</b> 2026-05-11</span>
        <span><b>編集</b> NY-squared 編集部</span>
        <span><b>所要</b> 約 6 分</span>
      </div>
    </div>
  </section>

  <!-- ============ SECTION 01 自己分析の目的 + Will/Can/Must ============ -->
  <section class="lp-section" id="sec-1" aria-labelledby="h2-1">
    <div class="container">
      <p class="section-num">SECTION / 01</p>
      <h2 id="h2-1">自己分析は「方向性の決定」を担う</h2>
      <p class="section-lede">自己分析を行わずに求人を眺めると表層的な条件で判断しミスマッチに繋がる可能性があるとされています。自己分析は転職活動全体の方向性を決める最重要工程です。標準は 3-5 時間 (基本版 1-2 時間 / 詳細版 5-10 時間)。</p>

      <div class="branch-grid">
        <article class="branch">
          <span class="tag">目的 ①</span>
          <h4>応募職種の絞り込み</h4>
          <p>適性のある業界・職種を特定し、求人サーチを効率化。</p>
        </article>
        <article class="branch">
          <span class="tag">目的 ②</span>
          <h4>強み・志望動機の言語化</h4>
          <p>職務経歴書 + 面接で説得力のあるエピソードを構築。</p>
        </article>
        <article class="branch">
          <span class="tag">目的 ③</span>
          <h4>入社後ミスマッチの回避</h4>
          <p>自分の価値観 + 求められる役割の一致を事前確認。</p>
        </article>
        <article class="branch">
          <span class="tag">フレーム</span>
          <h4>Will / Can / Must (3 軸統合)</h4>
          <p>Will (価値観・将来ビジョン) × Can (職務スキル・実績) × Must (応募職種の役割・要件)。3 軸が重なる領域が転職の方向性。Will のみ=現実性欠ける/Can のみ=成長性欠ける/Must のみ=満足度欠ける。</p>
        </article>
      </div>

      <p class="compare-note">※ 本記事は <a href="https://www.mhlw.go.jp/" target="_blank" rel="noopener">厚生労働省</a> 職業情報提供サイト + <a href="https://www.jil.go.jp/" target="_blank" rel="noopener">JILPT</a> + <a href="https://www.kokusen.go.jp/" target="_blank" rel="noopener">国民生活センター</a> + <a href="https://www.meti.go.jp/policy/economy/jinzai/" target="_blank" rel="noopener">経済産業省 人材政策</a> + 各転職エージェント公開情報を整理した一般論であり、断定的事実ではありません。個別状況により大きく異なります。</p>

      <div class="cta-block tight">
        <a class="btn-cta" href={`${A8}&sitemicros=hub_features`} rel="sponsored nofollow noopener" target="_blank" referrerpolicy="no-referrer-when-downgrade" data-cta="hub_features">
          <span>フレームを踏まえ TechGo 公式サイトで詳細を確認する</span>
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ============ SECTION 02 3 ステップ + テンプレ ============ -->
  <section class="lp-section alt" id="sec-2" aria-labelledby="h2-2">
    <div class="container">
      <p class="section-num">SECTION / 02</p>
      <h2 id="h2-2">自己分析 3 ステップ進め方 + テンプレート</h2>
      <p class="section-lede">基本版 (1-2 時間) と詳細版 (5-10 時間) の 2 段階で進めることが推奨されます。</p>
      <div class="card-grid">
        <div class="card">
          <h3>基本版 (1-2 時間・Will/Can/Must の整理)</h3>
          <p>構成: ① 価値観の書き出し → ② 職務スキル棚卸し → ③ 求められる役割の整理 → ④ 3 軸の重なり領域特定。STEP 1 価値観 5-10 個 (成長・自由・安定・社会貢献等) / STEP 2 直近 3 年の習得スキル・経験を箇条書き / STEP 3 応募業界・職種の役割を求人票から抽出 / STEP 4 Will × Can × Must の交点を転職の方向性として整理。初めての転職・時間制約あり時に推奨。</p>
        </div>
        <div class="card">
          <h3>詳細版 (5-10 時間・キャリア全体の棚卸し)</h3>
          <p>基本版 + 過去エピソード深掘り + 他者フィードバック収集 + 強み弱み再評価 + キャリアプラン作成。過去の楽しかった/つらかった出来事を各 3-5 件・なぜそう感じたか深掘り + 元上司/同僚からのフィードバック 2-3 件入手 + 5 年後/10 年後の理想像描写。キャリアチェンジ・40 代以降の転職時に推奨。</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ SECTION 03 無料ツール 5 種 ============ -->
  <section class="lp-section" id="sec-3" aria-labelledby="h2-3">
    <div class="container">
      <p class="section-num">SECTION / 03</p>
      <h2 id="h2-3">無料の自己分析ツール 5 種 (一般情報)</h2>
      <div class="compare-wrap">
        <table class="compare" aria-label="無料自己分析ツール 5 種">
          <thead><tr><th>ツール</th><th>特徴</th></tr></thead>
          <tbody>
            <tr><td>リクナビ NEXT「グッドポイント診断」</td><td>8,568 通りの組み合わせから 5 つの強みを診断 (約 30 分・無料登録要)</td></tr>
            <tr><td>ミイダス「コンピテンシー診断」</td><td>行動特性・適性業界・上下司タイプ等を分析 (約 30 分・無料登録要)</td></tr>
            <tr><td>dodaキャンパス「キャリアタイプ診断」</td><td>価値観 × 行動特性 × 思考スタイルで適性を分析 (無料登録要)</td></tr>
            <tr><td>16Personalities (MBTI 系)</td><td>一般的な性格類型 16 タイプ診断 (無料・登録不要)</td></tr>
            <tr><td>VIA-IS (強み診断)</td><td>ペンシルバニア大学開発・24 種の強みを分析 (無料・登録要)</td></tr>
          </tbody>
        </table>
      </div>
      <p class="compare-note">※ 複数ツール併用で結果を比較する使い方が推奨されます。診断結果は参考情報として捉え、最終判断は自分の価値観 + 他者フィードバックで行うことが一般的とされています。</p>
      <div class="card-grid">
        <div class="card">
          <h3>分析フレームワーク 4 選 (ツールと併用)</h3>
          <p><strong>① モチベーショングラフ</strong>: 過去の出来事と感情の起伏を時系列で可視化し、価値観・やりがいの源泉を抽出。<br /><strong>② ジョハリの窓</strong>: 自分が知る/知らない × 他者が知る/知らない の 4 象限で「盲点の窓 (気づいていない強み)」を発見。</p>
        </div>
        <div class="card">
          <h3>フレームワーク (続き)</h3>
          <p><strong>③ SWOT 分析 (個人版)</strong>: 内部要因 Strength/Weakness × 外部要因 Opportunity/Threat (市場ニーズ・AI 代替リスク) で戦略を整理。<br /><strong>④ ストレングスファインダー</strong>: ギャラップ社開発・34 資質から強み上位を特定 (有料・書籍/Web)。複数フレーム併用で多角的に自己理解を深めるのが推奨されます。</p>
        </div>
      </div>
      <div class="cta-block tight">
        <a class="btn-cta" href={`${A8}&sitemicros=hub_salary`} rel="sponsored nofollow noopener" target="_blank" referrerpolicy="no-referrer-when-downgrade" data-cta="hub_salary">
          <span>診断ツールを踏まえ TechGo 公式サイトを確認する</span>
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ============ SECTION 04 職種別深掘り + NG ============ -->
  <section class="lp-section alt" id="sec-4" aria-labelledby="h2-4">
    <div class="container">
      <p class="section-num">SECTION / 04</p>
      <h2 id="h2-4">職種別 深掘りポイントとやりがちな NG パターン</h2>
      <p class="section-lede">職種別の深掘りポイント (営業=数値実績振り返り / エンジニア=技術スタック年表化 / マーケ=KPI 改善実績 / コンサル=成果指標言語化 / 管理職=マネジメント実績棚卸し) を押さえつつ、NG パターンを回避することが推奨されます。</p>
      <div class="counter-box">
        <h3>📌 やりがちな NG パターン (5 例・公開情報整理)</h3>
        <div class="row"><b>診断ツール結果を鵜呑みにする</b><span>機械的判定への過信 → 複数ツール比較 + 他者フィードバックで補正</span></div>
        <div class="row"><b>Will だけで方向性決定</b><span>Can/Must の検討不足 → 3 軸統合で重なり領域を必ず特定</span></div>
        <div class="row"><b>過去の失敗を整理せず棚卸し終了</b><span>ポジティブ偏重 → 失敗からの学び・改善行動も書き出す</span></div>
        <div class="row"><b>他者フィードバックを一切取らない</b><span>自己評価のみで完結 → 元上司/同僚 2-3 名から強み/弱みヒアリング</span></div>
        <div class="row"><b>時間制限なしで永遠に分析</b><span>完璧主義で行動が止まる → 基本版 1-2 時間で一旦締切・行動しながら更新</span></div>
        <p style="margin-top:12px;font-size:13px;color:var(--c-text-sub);">※ 自己分析は他者視点を取り入れることで質が大きく向上します。転職エージェントのキャリア面談・職種別キャリア相談・第三者視点での強み深掘りが有効。<br /><strong>YMYL リスク認識</strong>: 年収・キャリアは就業判断に直結。本記事は転職成功保証・効果保証ではなく、特定エージェント・診断ツールを推奨するものでもありません。</p>
      </div>

      <div class="cta-block">
        <a class="btn-cta" href={`${A8}&sitemicros=hub_final`} rel="sponsored nofollow noopener" target="_blank" referrerpolicy="no-referrer-when-downgrade" data-cta="hub_final">
          <span>自己分析サポートの最終確認は TechGo 公式サイトで</span>
          <span class="arrow" aria-hidden="true">→</span>
        </a>
        <p class="btn-cta-sub">※ 本記事は公開情報を整理した一般論であり、具体的な自己分析サポートは各転職エージェントのキャリア面談サービス等を活用してください。最終確認日: 2026-05-11。</p>
      </div>
    </div>
  </section>

  <!-- ============ SECTION 05 FAQ + 関連記事 ============ -->
  <section class="lp-section" id="sec-5" aria-labelledby="h2-5">
    <div class="container">
      <p class="section-num">SECTION / 05</p>
      <h2 id="h2-5">よくある質問・関連記事</h2>
