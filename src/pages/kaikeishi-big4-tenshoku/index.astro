---
/**
 * 会計士 BIG4 監査法人 転職 LP (ツインプロ・RichLayout 準拠)
 * ★326 DRY kaikeishi-tenshoku テンプレ流用
 * ★480 ツインプロ a8mat verbatim copy-paste (BWVTE 001 / BXB8X 003 / BXYE9 006)
 * ★354 honest: 誇大表現・No.1・絶対保証 禁止 / ★273 景表法配慮
 */
import RichLayout from '../../layouts/RichLayout.astro';

const A8 = 'https://px.a8.net/svt/ejp?a8mat=4B1THX+40OCS2+5B0Y+BWVTE';
const title = '会計士BIG4監査法人転職4社比較｜あずさ・トーマツ・EY・PwC選考対策と年収目安【2026年版】';
