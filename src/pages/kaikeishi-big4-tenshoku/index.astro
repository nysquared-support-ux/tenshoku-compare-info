const itemListSchema = {
  '@context': 'https://schema.org', '@type': 'ItemList',
  'name': 'BIG4監査法人転職エージェント主要4サービス比較',
  'description': '公認会計士・BIG4志望者向け転職エージェント4社の公開情報整理',
  'itemListOrder': 'https://schema.org/ItemListUnordered',
  'itemListElement': [
    {'@type': 'ListItem', 'position': 1, 'item': {'@type': 'Service', 'name': 'ツインプロ', 'serviceType': '会計士・税理士特化 転職エージェント', 'description': '士業有資格者特化・無料キャリア面談・BIG4関連非公開求人あり', 'provider': {'@type': 'Organization', 'name': 'MyVision 株式会社'}}},
    {'@type': 'ListItem', 'position': 2, 'item': {'@type': 'Service', 'name': 'マイナビ会計士', 'serviceType': '会計士特化 転職エージェント', 'description': '公認会計士特化・大手系列・若手〜中堅対応', 'provider': {'@type': 'Organization', 'name': '株式会社マイナビ'}}},
    {'@type': 'ListItem', 'position': 3, 'item': {'@type': 'Service', 'name': 'MS-Japan', 'serviceType': '管理部門特化 転職エージェント', 'description': '経理・財務・会計士・税理士向け・事業会社経理転職に強み', 'provider': {'@type': 'Organization', 'name': '株式会社 MS-Japan'}}},
    {'@type': 'ListItem', 'position': 4, 'item': {'@type': 'Service', 'name': 'リクルートエージェント', 'serviceType': '総合型転職エージェント (士業含む)', 'description': '求人数60万件以上・BIG4関連求人もカバー・士業特化との併用推奨', 'provider': {'@type': 'Organization', 'name': '株式会社リクルート'}}},
  ],
};

const faq = [
  { q: 'BIG4監査法人への転職に士業特化エージェントは必要ですか?', a: '公開情報上、BIG4監査法人のハイクラス・非公開求人は士業特化エージェント経由でアクセスしやすいとされています。ツインプロ・マイナビ会計士等は公認会計士向けの専門求人情報を保有しているとされており、総合型(リクルート等)との2社以上の並行登録が推奨されることが多いとされています。' },
  { q: 'BIG4(あずさ・トーマツ・EY・PwC)の特徴・社風の違いは?', a: '公開情報上、①有限責任あずさ監査法人(KPMG)はグローバル対応・金融業界に強みとされ、②有限責任監査法人トーマツ(Deloitte)は国内最大規模・多様な業種対応、③EY新日本有限責任監査法人はワークライフバランス重視の評判があるとされ、④PwC Japan有限責任監査法人はアドバイザリー部門との連携が強みとされています。実際の社風・業務内容は時期・部門により異なりますため、各法人への直接確認が推奨されます。' },
  { q: 'BIG4監査法人の年収目安はどれくらいですか?', a: '公開情報(令和5年賃金構造基本統計調査等)上、BIG4監査法人の年収目安はスタッフ級で約400〜600万円、マネージャー級で約800〜1,200万円、パートナー級で約1,000万円以上とされています。ただし役職・部門・個人評価により大きく異なるため、具体的な水準は各エージェントのキャリア面談でご確認ください。' },
  { q: 'BIG4監査法人の選考フローはどのようなものですか?', a: '公開情報上、BIG4への転職選考は①書類選考→②面接(2〜3回)→③内定のフローが一般的とされています。公認会計士試験合格者向けには合格発表後11月前後に集中的に採用活動が行われるとされています。中途転職では業務経験・スキルセット・志望動機の具体性が重視されるとされています。' },
  { q: 'BIG4監査法人からの転職先(キャリアパス)は?', a: '公開情報上、BIG4出身者は転職市場で高い評価を受けるとされており、①事業会社の経理・財務・CFO候補、②FAS(財務アドバイザリー)・M&Aアドバイザー、③コンサルティングファーム、④税理士法人・会計事務所独立等のキャリアパスが比較的選択されやすいとされています。詳細は士業特化エージェントへご相談ください。' },
  { q: '公認会計士試験合格後すぐにBIG4に入れますか?', a: '公開情報上、公認会計士試験合格後(論文合格後)のBIG4就職は合格発表直後の11月前後が最も求人が集中するとされています。合格見込み段階からエージェント登録・情報収集を始めることが推奨されることが多いとされています。ただし採用状況は年度・各法人の状況により異なります。' },
  { q: '監査法人以外の会計士向け転職先として何がありますか?', a: '公開情報上、公認会計士の就職先として①BIG4等監査法人、②中小監査法人、③税理士法人、④事業会社経理・財務部門、⑤コンサルティングファーム(FAS・戦略等)、⑥ベンチャー/スタートアップCFO・IPO準備担当等が挙げられるとされています。キャリア設計の詳細はエージェント面談が推奨されます。' },
  { q: 'BIG4転職の志望動機はどう書けばよいですか?', a: '公開情報上、BIG4各法人の志望動機では①特定法人を選ぶ理由(グローバル・業種・部門の強み)、②実現したいキャリアパスとのリンク、③自身の経験・スキルをどう活かすかの3点を具体的に記載することが重要とされています。実務経験・実績の数値化も評価されるとされています。' },
  { q: 'BIG4と中堅監査法人の違いは何ですか?', a: '公開情報上、BIG4は①グローバル案件対応力、②給与水準の高さ、③ブランド・転職市場での評価、④業務の専門分化(監査・アドバイザリー等)が特徴とされています。一方で中堅監査法人は①より多様な業務を早期に経験できる、②コンパクトな組織での働きやすさが強みとされています。' },
  { q: '士業特化エージェントと総合型エージェントはどちらが良いですか?', a: '公開情報上、BIG4監査法人転職では①士業特化エージェント(ツインプロ等)の業界知見・非公開求人へのアクセス と ②総合型エージェント(リクルート等)の求人数を組み合わせた2〜3社並行登録が推奨されることが多いとされています。どちらか一方に絞るよりも、情報収集の幅を広げることが一般的なアドバイスとされています。' },
];

const faqSchema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  'mainEntity': faq.map(f => ({ '@type': 'Question', 'name': f.q, 'acceptedAnswer': { '@type': 'Answer', 'text': f.a } })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  'itemListElement': breadcrumb.map((b, i) => ({
    '@type': 'ListItem', 'position': i + 1,
    'name': b.name, ...(b.url ? { 'item': `https://tenshoku-compare-info.pages.dev${b.url}` } : {}),
  })),
};

const articleSchema = {
  '@context': 'https://schema.org', '@type': 'Article',
  'headline': title,
  'description': description,
  'datePublished': '2026-05-22',
  'dateModified': '2026-05-22',
  'author': { '@type': 'Organization', 'name': 'NY-squared 編集部' },
  'publisher': { '@type': 'Organization', 'name': 'NY-squared', 'url': 'https://tenshoku-compare-info.pages.dev/' },
};
