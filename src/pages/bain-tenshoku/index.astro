          <thead><tr><th>ポジション</th><th>滞在年数</th><th>年収レンジ</th><th>主な役割</th></tr></thead>
          <tbody>
            <tr><td>アソシエイトコンサルタント</td><td>1-3 年</td><td>700-1,000万円</td><td>分析 / 仮説検証 / 資料作成</td></tr>
            <tr><td>コンサルタント</td><td>2-4 年</td><td>1,200-1,800万円</td><td>サブ案件リード / クライアント窓口</td></tr>
            <tr><td>マネージャー</td><td>2-4 年</td><td>1,800-2,500万円</td><td>案件統括 / 提案リード</td></tr>
            <tr><td>プリンシパル</td><td>3-5 年</td><td>2,300-2,900万円</td><td>領域責任 / 大型案件責任</td></tr>
            <tr><td>パートナー</td><td>無期限</td><td>3,000万円+</td><td>クライアント / 経営 / 戦略立案</td></tr>
          </tbody>
