  { q: 'ハイクラス特化エージェントのおすすめは?', a: '一般的に ① リクルートダイレクトスカウト (大手・スカウト型) ② JAC Recruitment (両面型・専門職) ③ ビズリーチ (スカウト型・経営層) の 3 サービスが代表とされています。複数登録で求人カバレッジ最大化が推奨されます。' },
  { q: '35 歳定年説は本当ですか?', a: '一般的に「35 歳定年説」は古い慣習で現在は形骸化しているとされています。実際は 40 代・50 代でもマネジメント経験・専門性で転職成功するケースが増加傾向とされています。但し業界・職種により差があるとされています。' },
  { q: 'スカウトが来ない時の対策は?', a: '一般的に ① 職務経歴書の充実 (実績数値必須) ② スキル/資格の最新化 ③ 希望年収の妥当性確認 ④ 複数サービス並行登録 の 4 点が推奨されます。スカウト数は登録後 1-2 ヶ月で増加する傾向とされています。' },
  { q: 'ハイクラス転職で年収が下がるケースは?', a: '一般的に ① 業界転換時 (異業種チャレンジ) ② 役職降格 (専門職転向) ③ 大企業→ベンチャー転職 で年収が下がるケースがあるとされています。但し中長期的なキャリア価値で判断することが推奨されます。' },
  { q: '年収交渉のコツは?', a: '一般的に ① 現年収 + 業界相場の事前調査 ② 希望年収の根拠 (実績/市場価値) 準備 ③ エージェント経由での交渉依頼 (直接交渉を避ける) ④ 内定後の最終交渉タイミング が推奨されます。' },
  { q: '転職活動はどのくらいの期間が目安ですか?', a: '一般的にハイクラス転職は 3-6 ヶ月が標準とされています。スカウト待機期間 1-2 ヶ月 + 面談/面接 2-3 ヶ月 + 退職交渉 1 ヶ月の合計が目安です。早期転職の場合は 1-2 ヶ月で完了するケースもあるとされています。' },
];
const faqSchema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  'mainEntity': faq.map(f => ({ '@type': 'Question', 'name': f.q, 'acceptedAnswer': { '@type': 'Answer', 'text': f.a } })),
};
const itemListSchema = {
  '@context': 'https://schema.org', '@type': 'ItemList',
  'name': 'ハイクラス転職特化エージェント 3 サービス比較',
  'description': '年収 600 万円以上の経営層・管理職向けハイクラス特化エージェント (公開情報整理)',
  'itemListOrder': 'https://schema.org/ItemListUnordered',
  'itemListElement': [
    { '@type': 'ListItem', 'position': 1, 'item': { '@type': 'Service', 'name': 'リクルートダイレクトスカウト', 'serviceType': 'スカウト型ハイクラス転職エージェント', 'description': '大手リクルート運営・求人 24 万件以上・ヘッドハンター 4,800 名以上 (公開情報)', 'provider': { '@type': 'Organization', 'name': '株式会社リクルート' }, 'audience': { '@type': 'Audience', 'audienceType': '年収 600-2,000 万円のビジネスパーソン' } } },
    { '@type': 'ListItem', 'position': 2, 'item': { '@type': 'Service', 'name': 'JAC Recruitment', 'serviceType': '両面型ハイクラス転職エージェント', 'description': '管理職/専門職特化・両面型 (1 人のコンサルタントが企業と求職者双方を担当)', 'provider': { '@type': 'Organization', 'name': '株式会社ジェイ エイ シー リクルートメント' }, 'audience': { '@type': 'Audience', 'audienceType': '年収 600-2,000 万円の管理職・専門職' } } },
    { '@type': 'ListItem', 'position': 3, 'item': { '@type': 'Service', 'name': 'ビズリーチ', 'serviceType': 'スカウト型ハイクラス転職プラットフォーム', 'description': '経営層特化・即戦力ヘッドハンター直接スカウト・有料プラン (プレミアム) で全機能利用可', 'provider': { '@type': 'Organization', 'name': '株式会社ビズリーチ' }, 'audience': { '@type': 'Audience', 'audienceType': '年収 750-2,000 万円の経営層・管理職' } } },
