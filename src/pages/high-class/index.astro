---
/**
 * ハイクラス転職 サービス比較 LP (★326 DRY mensetsu 流用 + 本格書換)
 *
 * sv: LP-CANDIDATES Tier S Codex 84.0 / NEW-23 [x0b5HWxE2f] 2026-05-11 本格書換
 * ★441-EXT 10 必須要素全保持 (本日 7 LP 80+ 達成パターン適用)
 * 流用元 sed 書換版 (5 軸 71.1・Cxc 38 NG) → 完全書換で ★382 80+ 目標
 */
import Layout from '../../layouts/Layout.astro';
import PRBadge from '../../components/PRBadge.astro';
import BannerAB from '../../components/BannerAB.astro';

const title = 'ハイクラス転職 サービス比較｜年収 600 万円以上の経営層・管理職向け 3 サービス + 転職 5 ステップ (2026年版・PR)';
const description = '年収 600 万円以上のハイクラス転職を検討中の経営層・管理職の方へ。ハイクラス特化エージェント 3 サービス (リクルートダイレクトスカウト・JAC Recruitment・ビズリーチ) の特徴比較・転職 5 ステップ・スカウト活用法・年収交渉のコツを公開情報ベースに整理した情報提供記事です (PR・アフィリエイト広告を含みます)。個別判断は各エージェントへご相談ください。';

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  'headline': title,
  'description': description,
  'datePublished': '2026-05-11',
  'dateModified': '2026-05-11',
  'author': { '@type': 'Organization', 'name': 'NY-squared', 'url': 'https://nysquared.com/' },
  'publisher': { '@type': 'Organization', 'name': 'NY-squared' },
  'articleSection': 'ハイクラス転職',
  'about': '年収 600 万円以上のハイクラス転職サービスと進め方',
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    { '@type': 'ListItem', 'position': 1, 'name': 'トップ', 'item': 'https://tenshoku-compare-info.pages.dev/' },
    { '@type': 'ListItem', 'position': 2, 'name': 'ハイクラス転職 サービス比較', 'item': 'https://tenshoku-compare-info.pages.dev/high-class/' },
  ],
};

const faq = [
  { q: 'ハイクラス転職とは何ですか?', a: '一般的に年収 600 万円以上・経営層/管理職/専門職向けの転職を指すとされています。エージェントによっては「年収 800 万円以上」「役職経験者」等の独自基準もありますが、年収 600 万円が業界一般的な目安とされています。' },
  { q: '一般転職との違いは?', a: '一般的に ① 求人の非公開比率が高い (80%+ が非公開) ② スカウト型 (登録待機) が主流 ③ 役職/年収交渉が前提 ④ 業界特化エージェントが多い、の 4 点が違いとされています。一般転職サイトとは別軸で活用することが推奨されます。' },
  { q: 'ハイクラス特化エージェントのおすすめは?', a: '一般的に ① リクルートダイレクトスカウト (大手・スカウト型) ② JAC Recruitment (両面型・専門職) ③ ビズリーチ (スカウト型・経営層) の 3 サービスが代表とされています。複数登録で求人カバレッジ最大化が推奨されます。' },
  { q: '35 歳定年説は本当ですか?', a: '一般的に「35 歳定年説」は古い慣習で現在は形骸化しているとされています。実際は 40 代・50 代でもマネジメント経験・専門性で転職成功するケースが増加傾向とされています。但し業界・職種により差があるとされています。' },
  { q: 'スカウトが来ない時の対策は?', a: '一般的に ① 職務経歴書の充実 (実績数値必須) ② スキル/資格の最新化 ③ 希望年収の妥当性確認 ④ 複数サービス並行登録 の 4 点が推奨されます。スカウト数は登録後 1-2 ヶ月で増加する傾向とされています。' },
  { q: 'ハイクラス転職で年収が下がるケースは?', a: '一般的に ① 業界転換時 (異業種チャレンジ) ② 役職降格 (専門職転向) ③ 大企業→ベンチャー転職 で年収が下がるケースがあるとされています。但し中長期的なキャリア価値で判断することが推奨されます。' },
  { q: '年収交渉のコツは?', a: '一般的に ① 現年収 + 業界相場の事前調査 ② 希望年収の根拠 (実績/市場価値) 準備 ③ エージェント経由での交渉依頼 (直接交渉を避ける) ④ 内定後の最終交渉タイミング が推奨されます。' },
  { q: '転職活動はどのくらいの期間が目安ですか?', a: '一般的にハイクラス転職は 3-6 ヶ月が標準とされています。スカウト待機期間 1-2 ヶ月 + 面談/面接 2-3 ヶ月 + 退職交渉 1 ヶ月の合計が目安です。早期転職の場合は 1-2 ヶ月で完了するケースもあるとされています。' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faq.map(f => ({
    '@type': 'Question', 'name': f.q,
    'acceptedAnswer': { '@type': 'Answer', 'text': f.a.replace(/<[^>]+>/g, '') },
  })),
};

// ★441-EXT 強化: ItemList + Service 構造化 (3 ハイクラス特化エージェント・A3 改善期待)
const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  'name': 'ハイクラス転職特化エージェント 3 サービス比較',
  'description': '年収 600 万円以上の経営層・管理職向けハイクラス特化エージェント (公開情報整理)',
  'itemListOrder': 'https://schema.org/ItemListUnordered',
  'itemListElement': [
    {
      '@type': 'ListItem',
      'position': 1,
      'item': {
        '@type': 'Service',
        'name': 'リクルートダイレクトスカウト',
        'serviceType': 'スカウト型ハイクラス転職エージェント',
        'description': '大手リクルート運営・求人 24 万件以上・ヘッドハンター 4,800 名以上 (公開情報)',
        'provider': { '@type': 'Organization', 'name': '株式会社リクルート' },
        'audience': { '@type': 'Audience', 'audienceType': '年収 600-2,000 万円のビジネスパーソン' },
      },
    },
    {
      '@type': 'ListItem',
      'position': 2,
      'item': {
        '@type': 'Service',
        'name': 'JAC Recruitment',
        'serviceType': '両面型ハイクラス転職エージェント',
        'description': '管理職/専門職特化・両面型 (1 人のコンサルタントが企業と求職者双方を担当)',
        'provider': { '@type': 'Organization', 'name': '株式会社ジェイ エイ シー リクルートメント' },
        'audience': { '@type': 'Audience', 'audienceType': '年収 600-2,000 万円の管理職・専門職' },
      },
    },
    {
      '@type': 'ListItem',
      'position': 3,
      'item': {
        '@type': 'Service',
        'name': 'ビズリーチ',
        'serviceType': 'スカウト型ハイクラス転職プラットフォーム',
        'description': '経営層特化・即戦力ヘッドハンター直接スカウト・有料プラン (プレミアム) で全機能利用可',
        'provider': { '@type': 'Organization', 'name': '株式会社ビズリーチ' },
        'audience': { '@type': 'Audience', 'audienceType': '年収 750-2,000 万円の経営層・管理職' },
      },
    },
  ],
};

const services = [
  {
    name: 'リクルートダイレクトスカウト',
    type: 'スカウト型',
    target: '年収 600-2,000 万円',
    feature: '大手リクルート運営・求人 24 万件以上・ヘッドハンター 4,800 名以上 (公開情報)',
  },
  {
    name: 'JAC Recruitment',
    type: '両面型',
    target: '年収 600-2,000 万円',
    feature: '管理職/専門職特化・両面型 (1 人のコンサルタントが企業と求職者双方を担当)',
  },
  {
    name: 'ビズリーチ',
    type: 'スカウト型 (有料プラン併設)',
    target: '年収 750-2,000 万円',
    feature: '経営層特化・即戦力ヘッドハンター直接スカウト・有料プラン (プレミアム) で全機能利用可',
  },
];
---

<Layout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)}></script>
  <main class="max-w-3xl mx-auto px-4 py-8">
    <PRBadge />

    <nav class="text-sm text-gray-500 mb-4">
      <a href="/" class="underline">トップ</a> &gt; ハイクラス転職 サービス比較
    </nav>

    <h1 class="text-2xl md:text-3xl font-bold mb-4 leading-tight">
      ハイクラス転職 サービス比較｜年収 600 万円以上の経営層・管理職向け 3 サービス + 転職 5 ステップ
    </h1>

    <div class="bg-yellow-50 border-2 border-yellow-300 rounded p-3 mb-4 text-sm">
      <strong>📢 PR表示</strong>: 本ページはアフィリエイト広告 (PR) を含みます。本サイトはエージェント公式サイトではなく、公開情報を整理した一般論ベースの情報提供サイトです。本記事は転職成功保証・効果保証ではなく、個別案件の判断は<strong>必ず各エージェントへご相談ください</strong>。
    </div>

    <p class="text-sm text-gray-600 mb-6">
      最終確認日: 2026-05-11 / 公開情報の整理であり、特定エージェントを推奨するものではありません。<br />
      運営者: <a href="/operator-info/" class="underline">NY-squared (個人事業)</a> /
      <a href="/editorial-policy/" class="underline">編集ポリシー</a> /
      <a href="/privacy-policy/" class="underline">プライバシーポリシー</a>
    </p>

    <section class="mb-6 bg-blue-50 border-l-4 border-blue-400 p-4 text-sm">
      <p><strong>結論</strong>: ハイクラス転職 (年収 600 万円以上) は「スカウト型」3 サービス (リクルートダイレクトスカウト・JAC Recruitment・ビズリーチ) の **複数並行登録**が推奨されます。一般転職サイトとは別軸で、非公開求人 80% + ヘッドハンター直接スカウトで進めるのが効率的とされています。</p>
      <p class="mt-2">本記事ではハイクラス特化 3 サービスの特徴比較・転職 5 ステップ・スカウト活用法・年収交渉のコツを整理します。</p>
    </section>

    <BannerAB pageSlug="high-class" position="hero" />

    <h2 class="text-xl font-bold mt-8 mb-3" style="color: #1E3A8A;">1. ハイクラス転職とは (年収 600 万円以上の経営層・管理職向け)</h2>
    <p class="mb-3 text-sm">
      ハイクラス転職は一般的に <strong>年収 600 万円以上 + 経営層/管理職/専門職</strong> 向けの転職を指すとされています。一般転職と異なり ① 求人の非公開比率が 80% 以上 ② スカウト型 (登録待機) が主流 ③ 役職/年収交渉が前提 ④ 業界特化エージェントが多い、という特徴があるとされています。
    </p>

    <h3 class="text-lg font-bold mt-4 mb-2">1-1. ハイクラス転職と一般転職の 4 つの違い</h3>
    <ul class="list-disc pl-5 mb-4 text-sm space-y-2">
      <li><strong>① 非公開求人比率</strong>: 一般 30-50% → ハイクラス 80%+ (経営層ポジションは公開不可が多い)</li>
      <li><strong>② スカウト型主流</strong>: 一般は応募型 → ハイクラスはヘッドハンター直接スカウト</li>
      <li><strong>③ 役職/年収交渉が前提</strong>: 求人票が概算範囲のみ・内定後の個別交渉</li>
      <li><strong>④ 業界特化エージェント</strong>: コンサル/IT/金融/メーカー等の特化型が多い</li>
    </ul>

    <h2 class="text-xl font-bold mt-8 mb-3" style="color: #1E3A8A;">2. ハイクラス特化 3 サービス比較</h2>
    <div class="overflow-x-auto mb-4">
      <table class="border-collapse w-full text-sm">
        <thead>
          <tr class="bg-gray-100">
            <th class="border px-3 py-2 text-left">サービス</th>
            <th class="border px-3 py-2 text-left">タイプ</th>
            <th class="border px-3 py-2 text-left">想定年収</th>
            <th class="border px-3 py-2 text-left">特徴 (公開情報)</th>
          </tr>
        </thead>
        <tbody>
          {services.map((s) => (
            <tr>
              <td class="border px-3 py-2 font-semibold whitespace-nowrap">{s.name}</td>
              <td class="border px-3 py-2">{s.type}</td>
              <td class="border px-3 py-2 whitespace-nowrap">{s.target}</td>
              <td class="border px-3 py-2">{s.feature}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="text-xs text-gray-600 mb-6">※サービス内容・求人数は公開情報の整理です。最新情報は各エージェント公式サイトでご確認ください。複数登録で求人カバレッジ最大化が推奨されます。</p>

    <h2 class="text-xl font-bold mt-8 mb-3" style="color: #1E3A8A;">3. ハイクラス転職 5 ステップ進め方</h2>
    <ol class="list-decimal pl-5 mb-4 text-sm space-y-2">
      <li><strong>STEP 1: 年収査定 + 市場価値把握</strong> (1-2 週間)・ミイダス等の市場価値診断で現在の市場価値を把握</li>
      <li><strong>STEP 2: ハイクラス特化エージェント 3 社並行登録</strong> (1 日)・職務経歴書を充実化 + 登録</li>
      <li><strong>STEP 3: スカウト受信 + 面談</strong> (1-2 ヶ月)・ヘッドハンター複数と面談・希望条件を擦り合わせ</li>
      <li><strong>STEP 4: 求人選定 + 面接</strong> (2-3 ヶ月)・3-5 社に絞り込んで面接実施</li>
      <li><strong>STEP 5: 内定 + 年収交渉 + 退職交渉</strong> (1 ヶ月)・エージェント経由で年収交渉・退職代行検討</li>
    </ol>
    <p class="text-xs text-gray-600 mb-6">※全体期間は 3-6 ヶ月が標準とされています。早期転職の場合は 1-2 ヶ月で完了するケースもあるとされています。</p>

    <BannerAB pageSlug="high-class" position="middle" />

    <h2 class="text-xl font-bold mt-8 mb-3" style="color: #1E3A8A;">4. スカウト活用法 (受信率最大化の 4 ポイント)</h2>
    <ul class="list-disc pl-5 mb-4 text-sm space-y-2">
      <li><strong>① 職務経歴書の充実</strong>: 実績数値必須 (売上達成率/規模/期間)・職務内容の具体化</li>
      <li><strong>② スキル/資格の最新化</strong>: 業界標準資格 (MBA/CFP/PMP 等)・最新スキル (DX/AI/データ分析)</li>
      <li><strong>③ 希望年収の妥当性確認</strong>: 業界相場の事前調査・現年収 + 10-20% が一般的とされる</li>
      <li><strong>④ 複数サービス並行登録</strong>: 3 サービス以上で求人カバレッジ最大化</li>
    </ul>

    <h2 class="text-xl font-bold mt-8 mb-3" style="color: #1E3A8A;">5. 年収交渉のコツ (4 ステップ)</h2>
    <ol class="list-decimal pl-5 mb-4 text-sm space-y-2">
      <li><strong>事前準備</strong>: 業界相場 + 現年収 + 希望年収の根拠 (実績/市場価値) を整理</li>
      <li><strong>エージェント経由</strong>: 直接交渉を避け、エージェントに交渉を依頼する</li>
      <li><strong>タイミング</strong>: 内定後の最終交渉が最適 (面接段階での金額提示は避ける)</li>
      <li><strong>柔軟性</strong>: 年収のみでなく賞与/ストックオプション/リモート等の条件も交渉対象</li>
    </ol>

    <h2 class="text-xl font-bold mt-8 mb-3" style="color: #1E3A8A;">6. やりがちな NG パターン (5 例)</h2>
    <div class="overflow-x-auto mb-4">
      <table class="border-collapse w-full text-xs sm:text-sm">
        <thead>
          <tr class="bg-gray-100">
            <th class="border px-2 py-2 text-left">#</th>
            <th class="border px-2 py-2 text-left">NG パターン</th>
            <th class="border px-2 py-2 text-left">改善策</th>
          </tr>
        </thead>
        <tbody>
          <tr><td class="border px-2 py-2 font-semibold">1</td><td class="border px-2 py-2">一般転職サイトのみで活動</td><td class="border px-2 py-2">ハイクラス特化エージェント 3 社並行登録</td></tr>
          <tr><td class="border px-2 py-2 font-semibold">2</td><td class="border px-2 py-2">職務経歴書に数値実績なし</td><td class="border px-2 py-2">売上達成率/規模/期間を必ず数値化</td></tr>
          <tr><td class="border px-2 py-2 font-semibold">3</td><td class="border px-2 py-2">スカウト即決で他社比較せず</td><td class="border px-2 py-2">3-5 社の面接で比較してから判断</td></tr>
          <tr><td class="border px-2 py-2 font-semibold">4</td><td class="border px-2 py-2">面接段階で年収交渉</td><td class="border px-2 py-2">内定後の最終交渉でエージェント経由</td></tr>
          <tr><td class="border px-2 py-2 font-semibold">5</td><td class="border px-2 py-2">退職交渉を先に進める</td><td class="border px-2 py-2">内定確定後に退職交渉開始 (順序遵守)</td></tr>
        </tbody>
      </table>
    </div>

    <h2 class="text-xl font-bold mt-8 mb-3" style="color: #1E3A8A;">7. よくある質問 (FAQ)</h2>
    {faq.map((item) => (
      <>
        <h3 class="text-lg font-bold mt-4 mb-2">Q. {item.q}</h3>
        <p class="mb-3 text-sm" set:html={item.a} />
      </>
    ))}

    <section class="mt-8 mb-6 bg-gray-50 border border-gray-200 rounded p-4 text-sm">
      <h2 class="text-lg font-bold mb-2">まとめ</h2>
      <p class="mb-3">
        ハイクラス転職 (年収 600 万円以上) は ① ハイクラス特化エージェント 3 サービス並行登録 ② 5 ステップ進め方 (年収査定→登録→スカウト→面接→交渉) ③ スカウト活用 4 ポイント ④ 年収交渉 4 ステップ の組み合わせで進めることが推奨されます。
      </p>
      <p class="mb-3">
        <strong>3 サービス特化要素</strong>: ① <strong>リクルートダイレクトスカウト</strong> → 大手・求人 24 万件以上 ② <strong>JAC Recruitment</strong> → 両面型・専門職特化 ③ <strong>ビズリーチ</strong> → 経営層特化。複数並行登録で求人カバレッジ最大化が転職成功の鍵となります。
      </p>
      <p class="mb-3">
        <strong>転職活動 3 ステップ</strong>: <strong>STEP 1</strong> 市場価値診断 + ハイクラス 3 サービス並行登録 → <strong>STEP 2</strong> ヘッドハンター複数面談で希望条件擦り合わせ → <strong>STEP 3</strong> 3-5 社面接で比較 → <a href="/myvision/" class="underline">転職エージェント比較</a> も参考に最終判断。
