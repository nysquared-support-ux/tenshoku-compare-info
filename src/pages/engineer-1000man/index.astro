import RichLayout from '../../layouts/RichLayout.astro';

const A8 = 'https://px.a8.net/svt/ejp?a8mat=4B1LPN+E39C6Q+5B0Y+HV7V6';
const title = 'エンジニア 年収 1000 万円への道｜キャリアパス 5 種 + 必須スキル整理（2026年5月時点・公開情報整理・PR）';
const description = '年収 1000 万円超を目指す IT エンジニア向け。キャリアパス 5 種 (スペシャリスト / マネジメント / 外資 / SaaS / フリーランス) + 必須スキル + 業界別年収帯を JILPT/IPA/厚労省 公的統計 + 各転職エージェント公開求人情報サンプルに基づき整理した情報提供記事です (PR・アフィリエイト広告を含みます)。';
const breadcrumb = [
  { name: 'ホーム', url: '/' },
  { name: 'ハイクラス転職', url: '/high-class/' },
  { name: 'エンジニア 年収 1000 万円' },
