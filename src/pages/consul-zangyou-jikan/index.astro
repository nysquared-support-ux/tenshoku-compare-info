      <div class="compare-wrap">
        <table class="compare" aria-label="ファーム別残業時間目安">
          <thead><tr><th>ファーム種別</th><th>月残業目安</th><th>繁忙期</th><th>働き方の傾向</th></tr></thead>
          <tbody>
            <tr><td>戦略系 (BCG / McK / Bain)</td><td>60-100 時間</td><td>100 時間超のケース</td><td>短期高負荷 + 案件サイクル速い</td></tr>
            <tr><td>総合系 (アクセンチュア / PwC / ベイカレント)</td><td>40-80 時間</td><td>80-100 時間</td><td>案件単位で変動</td></tr>
            <tr><td>FAS 系 (Deloitte FAS / PwC AS)</td><td>50-90 時間</td><td>90-110 時間</td><td>M&A 案件期は高負荷</td></tr>
            <tr><td>IT 系 (アクセンチュア Tech / IBM)</td><td>40-70 時間</td><td>80-90 時間</td><td>実装フェーズで変動</td></tr>
