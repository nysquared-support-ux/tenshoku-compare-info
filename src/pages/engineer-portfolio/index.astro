const faq = [
  { q: 'GitHubをポートフォリオとして活用する際の具体的なポイントは何ですか？', a: 'Readmeの充実、コミット履歴の整理、コードの品質が重要です。特にプロジェクトの目的や使用技術を明記したReadmeは、採用担当者が最初に目にする部分とされます。経済産業省が推進する「ITスキル標準（ITSS）」では技術者の能力可視化が重視されており、GitHubでの活動履歴はその一助となると考えられます。' },
  { q: '実務未経験ですが、どのような個人開発作品が評価されやすいですか？', a: '自身の課題解決や、身近な不便を解消するような独創性のあるアプリケーションが評価されやすい傾向にあります。例えば、学習記録ツールや家計簿アプリなどです。単なるチュートリアルの模倣ではなく、0から1を生み出す過程で得た設計思想や問題解決能力を示すことが、技術力のアピールに繋がると一般にいわれます。' },
  { q: '採用担当者はポートフォリオのどこを一番見ていますか？', a: '技術選定の理由、コードの可読性、そして問題解決へのアプローチを重視する傾向があります。なぜその技術を使ったのか、チーム開発を想定したコーディングができているか、といった点が評価のポイントとされます。詳細は本記事の「採用担当者が見るポイント」のセクションもご参照ください。' },
  { q: 'ポートフォリオに掲載してはいけないもの、注意点はありますか？', a: '業務で作成したソースコードや、第三者の著作物を無断で掲載することは避けるべきです。これらは著作権法に抵触する可能性があります。また、動作しないデモやエラーが頻発するアプリケーションは、かえってマイナスの印象を与える可能性があるため、公開前に入念なチェックが推奨されます。' },
  { q: 'ポートフォリオ作成で最も重要な心構えは何ですか？', a: '「誰に、何を伝えたいか」を明確にすることが最も重要とされます。単に技術を羅列するのではなく、自身の強みや学習意欲、将来性を伝えるためのツールとしてポートフォリオを位置づけることが成功の鍵です。自身のスキルを客観的に棚卸しし、応募先企業が求める人物像と結びつける視点が求められます。' },
];
const faqSchema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  'mainEntity': faq.map(f => ({ '@type': 'Question', 'name': f.q, 'acceptedAnswer': { '@type': 'Answer', 'text': f.a } })),
};
