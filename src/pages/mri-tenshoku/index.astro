  { q: '三菱総研で採用される人材像は?', a: '一般公開情報によれば、研究・調査部門 = 政策 / 社会システム / 科学技術系の研究経験者、コンサル部門 = 経営企画 / 戦略系経験者、IT 部門 = SE / システムエンジニアがメインターゲットとされています。' },
  { q: '三菱総研と野村総研の違いは?', a: '三菱総研 = 政策提言 + 科学技術 + 社会システム重視、野村総研 (NRI) = 金融 IT + コンサル + システムソリューション重視という特性の違いがあるとされています。詳細は <a href="/nri-tenshoku/" class="underline">野村総研 転職</a> 参照。' },
  { q: '三菱総研の選考対策は?', a: '一般公開情報によれば、書類選考 → 適性検査 → ケース面接 (政策課題 / 経営課題) → 役員面接の流れで、論理思考 + 調査分析力 + 専門知見の3軸が評価軸とされています。詳細は <a href="/consul-case-mensetsu/" class="underline">ケース面接対策</a> 参照。' },
];
const faqSchema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faq.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const breadcrumbSchema = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: breadcrumb.map((b, i) => ({
    '@type': 'ListItem', position: i + 1, name: b.name,
    ...(b.url ? { item: 'https://tenshoku-compare-info.pages.dev' + b.url } : {}),
  })),
};
