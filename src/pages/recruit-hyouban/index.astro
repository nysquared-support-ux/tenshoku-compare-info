---
/**
 * リクルートエージェント 評判 LP (TechGo・Claude Design techgo 完全 class 構造準拠・★503 playbook Part A)
 * ★326 DRY engineer-1000man rich-v3 テンプレ流用・既存テキスト保持
 * ★441-EXT/★452: JSON-LD 3種 (Breadcrumb/FAQPage/ItemList) を RichLayout slot="head" で保持
 * ASP: TechGo a8mat=4B1LPN+E39C6Q+5B0Y+HV7V6 (★480 critical-urls.md L458 照合済)
 * ★327 backup: backups/2026-05-17-recruit-hyouban-before-rich/
 */
import RichLayout from '../../layouts/RichLayout.astro';

const A8 = 'https://px.a8.net/svt/ejp?a8mat=4B1LPN+E39C6Q+5B0Y+HV7V6';
const title = 'リクルートエージェントの評判は？利用者口コミで判明した真実2026年最新（PR）';
const description = 'リクルートエージェントの評判・口コミ・他社比較を公開情報ベースで整理。良い評判（求人数の多さ・キャリアアドバイザー・面接対策）と悪い評判（担当者の質・求人紹介スピード・ハイクラス劣勢）の両面を解説。向いている人/向かない人の3条件で判断できる情報提供記事です（PR・アフィリエイト広告を含みます）。';
const breadcrumb = [
  { name: 'ホーム', url: '/' },
  { name: '転職エージェント', url: '/osusume/' },
  { name: 'リクルートエージェント 評判' },
];

const breadcrumbSchema = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  'itemListElement': [
    { '@type': 'ListItem', 'position': 1, 'name': 'トップ', 'item': 'https://tenshoku-compare-info.pages.dev/' },
    { '@type': 'ListItem', 'position': 2, 'name': '転職エージェント', 'item': 'https://tenshoku-compare-info.pages.dev/osusume/' },
    { '@type': 'ListItem', 'position': 3, 'name': 'リクルートエージェント 評判', 'item': 'https://tenshoku-compare-info.pages.dev/recruit-hyouban/' },
  ],
};
const faq = [
  { q: 'リクルートエージェントの評判は本当に良いですか?', a: '一般的に良い評判が多い (求人数 60 万件以上・キャリアアドバイザーの質) 一方、担当者の質にバラつき・求人紹介スピードが速すぎるという指摘もあるとされています。両面を確認した上で判断することが推奨されます。' },
  { q: 'リクルートエージェントの求人数はどのくらい?', a: '一般的に公開求人 30 万件以上 + 非公開求人 30 万件以上 = 計 60 万件以上が業界最大とされています (公式公開情報)。但し非公開求人比率や年収帯別の内訳は地域・職種で異なります。' },
  { q: '担当者の質にバラつきがあるって本当ですか?', a: '一般的に大手エージェントは担当者数が多く、ベテラン vs 新人の経験差があるとされています。合わない場合は担当者変更を依頼することが推奨されます。' },
  { q: 'ハイクラス転職にも対応していますか?', a: '一般的にハイクラス転職 (年収 800 万円以上) では JAC Recruitment・ビズリーチ・リクルートダイレクトスカウト等が優勢とされています。リクルートエージェントは中堅・ハイクラス両対応ですが、ハイクラス特化では他社比較も推奨されます。' },
  { q: 'リクルートエージェントの面接対策は?', a: '一般的に書類添削・模擬面接・企業別対策資料の提供等の実質的サポートが評価されているとされています。但し対応の手厚さは担当者次第のケースもあるとされています。' },
  { q: '20代でも利用できますか?', a: '一般的に 20-40 代までの幅広い世代に対応しているとされています。20 代向けには「20 代の転職相談所」等の特化サービスもありますが、求人数を重視するならリクルートが選択肢となります。' },
  { q: '他のエージェントと併用すべきですか?', a: '一般的に 2-3 社並行登録が転職成功率を高めるとされています。リクルート (求人数) + 業界特化型 (専門性) + ハイクラス型 (年収アップ) の組み合わせが推奨されます。' },
  { q: '無料で利用できる仕組みは何故ですか?', a: '一般的に転職エージェントは採用企業から成功報酬 (年収の 30-35%) を受け取るビジネスモデルのため、求職者は無料で利用できる仕組みとされています。' },
  { q: 'リクルートエージェントの登録から内定までの期間は?', a: '一般的に 3-4 ヶ月が目安とされています (公開情報整理)。① 登録 + 担当者面談 1-2 週間 → ② 求人紹介 + 書類応募 1-2 ヶ月 → ③ 面接 + 内定 1-2 ヶ月の流れが標準的とされています。' },
  { q: '断られても再登録できますか?', a: '一般的に再登録は可能とされていますが、前回の活動状況・職務経歴等によって対応が異なる場合があるとされています。具体的な再登録条件は公式サイト・問い合わせ窓口でご確認ください。' },
  { q: '担当者を変更したい場合は?', a: '一般的にカスタマーセンターへの連絡で担当者変更の相談が可能とされています。エージェントとの相性も転職活動の重要な要素とされており、無理せず相談することが推奨されています。' },
];
const faqSchema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  'mainEntity': faq.map(f => ({ '@type': 'Question', 'name': f.q, 'acceptedAnswer': { '@type': 'Answer', 'text': f.a } })),
};
const itemListSchema = {
  '@context': 'https://schema.org', '@type': 'ItemList',
  'name': '転職エージェント主要 4 サービス比較',
  'description': '主要転職エージェント (リクルート / doda / マイナビ / JAC) の公開情報整理',
  'itemListOrder': 'https://schema.org/ItemListUnordered',
  'itemListElement': [
    {'@type': 'ListItem', 'position': 1, 'item': {'@type': 'Service', 'name': 'リクルートエージェント', 'serviceType': '転職エージェント (中堅 20-40代)', 'description': '求人数 60 万件+ (公開 30 万件 + 非公開 30 万件)・全業界対応', 'provider': {'@type': 'Organization', 'name': '株式会社リクルート'}}},
    {'@type': 'ListItem', 'position': 2, 'item': {'@type': 'Service', 'name': 'doda', 'serviceType': '転職エージェント + スカウト型', 'description': '20-30 代中堅・スカウト機能 + エージェント機能の両軸', 'provider': {'@type': 'Organization', 'name': 'パーソルキャリア株式会社'}}},
    {'@type': 'ListItem', 'position': 3, 'item': {'@type': 'Service', 'name': 'マイナビエージェント', 'serviceType': '転職エージェント (20代特化)', 'description': '20 代第二新卒・若手特化・面接サポート', 'provider': {'@type': 'Organization', 'name': '株式会社マイナビ'}}},
    {'@type': 'ListItem', 'position': 4, 'item': {'@type': 'Service', 'name': 'JAC Recruitment', 'serviceType': '両面型ハイクラス転職エージェント', 'description': '30-40 代管理職/専門職・コンサル/IT/金融特化', 'provider': {'@type': 'Organization', 'name': '株式会社ジェイ エイ シー リクルートメント'}}},
  ],
};
---

<RichLayout title={title} description={description} breadcrumb={breadcrumb}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)}></script>
  </Fragment>

  <!-- ============ FV ============ -->
  <section class="fv" aria-labelledby="fv-h1">
    <div class="container">
      <span class="fv-pill">リクルートエージェント 評判 / 公開情報と利用者傾向の整理</span>
      <h1 id="fv-h1">
        <span class="accent">リクルートエージェントの評判</span>は？<br />
        公開情報と利用者傾向の整理 2026年最新
      </h1>
      <p class="lede">
        リクルートエージェントは求人数業界主要候補・公開情報ベース (60 万件以上) + キャリアアドバイザーの質 + 面接対策の充実が評価される一方、担当者の質にバラつき・求人紹介スピードへの指摘があるとされています。20-40 代の中堅層に最適・ハイクラス特化なら他社併用が推奨されます。
      </p>
      <ul class="fv-bullets">
        <li>基本情報・特徴を公開情報で整理</li>
        <li>良い評判・悪い評判の両面を解説</li>
        <li>他社エージェントとの比較 + 向いている人/向かない人 3 条件</li>
        <li>厚労省・JILPT・国民生活センター・公式サイト 出典明示</li>
      </ul>
      <div class="cta-block">
        <p class="cta-note"><span class="pr-tag">PR</span>A8.net 経由のアフィリエイトリンクです。クリックしても利用者の費用負担は生じません。本サイトはリクルートエージェント公式サイトではなく、公開情報を整理した一般論ベースの情報提供サイトです。</p>
        <a class="btn-cta" href={`${A8}&sitemicros=hub_fv`} rel="sponsored nofollow noopener" target="_blank" referrerpolicy="no-referrer-when-downgrade" data-cta="hub_fv">
          <span>TechGo 公式サイトで無料カウンセリング詳細を見る</span>
          <span class="arrow" aria-hidden="true">→</span>
        </a>
        <p class="btn-cta-sub">※ 公式サイトに遷移します。本記事は公式公開情報・各メディア公開口コミ傾向の整理であり、独自の口コミ調査結果ではありません。最新情報は各エージェント公式サイトでご確認ください。</p>
      </div>
      <div class="fv-meta">
        <span><b>公開日</b> 2026-05-12</span>
        <span><b>最終更新</b> 2026-05-12</span>
        <span><b>編集</b> NY-squared 編集部</span>
        <span><b>所要</b> 約 6 分</span>
      </div>
    </div>
  </section>

  <!-- ============ SECTION 01 基本情報 + 良い評判 ============ -->
  <section class="lp-section" id="sec-1" aria-labelledby="h2-1">
    <div class="container">
      <p class="section-num">SECTION / 01</p>
      <h2 id="h2-1">基本情報・特徴と良い評判</h2>
      <p class="section-lede">運営会社: 株式会社リクルート (1960 年創業・東証プライム上場)。公開求人 30 万件 + 非公開求人 30 万件 = 計 60 万件以上 (業界主要候補・公開情報ベース)。対応年代 20-40 代中心・全業界全職種・完全無料 (採用企業から成功報酬)。</p>

      <div class="branch-grid">
        <article class="branch">
          <span class="tag">良い評判 ①</span>
          <h4>求人数の多さと非公開求人の質</h4>
          <p>60 万件以上は業界主要候補・特に非公開求人 (経営層・管理職・専門職) の質が評価。複数業界・複数職種を比較検討したいユーザーに適する。</p>
        </article>
        <article class="branch">
          <span class="tag">良い評判 ②</span>
          <h4>転職市場の知識が豊富なアドバイザー</h4>
          <p>転職市場・年収相場・各企業の社風等の知見が豊富。特に業界経験者のアドバイザーへの評価が高い。</p>
        </article>
        <article class="branch">
          <span class="tag">良い評判 ③</span>
          <h4>面接対策・書類添削の実質的サポート</h4>
          <p>履歴書/職務経歴書の添削・企業別の面接対策・模擬面接等の実質的サポート。但し手厚さは担当者次第のケースも。</p>
        </article>
        <article class="branch">
          <span class="tag">基本情報</span>
          <h4>料金・対応範囲</h4>
          <p>完全無料・20-40 代中心 (50 代対応もあり)・全業界全職種 (IT/Web・金融・コンサル・メーカー等)。</p>
        </article>
      </div>

      <p class="compare-note">※ 本記事は <a href="https://www.r-agent.com/" target="_blank" rel="noopener">リクルートエージェント公式サイト</a> + <a href="https://www.mhlw.go.jp/" target="_blank" rel="noopener">厚生労働省</a> + <a href="https://www.jil.go.jp/" target="_blank" rel="noopener">JILPT</a> + <a href="https://www.kokusen.go.jp/" target="_blank" rel="noopener">国民生活センター</a> + 各エージェント公式サイトの公開情報を整理した一般論であり、独自の口コミ調査結果ではありません。最終レビュー日: 2026-05-12。</p>

      <div class="cta-block tight">
        <a class="btn-cta" href={`${A8}&sitemicros=hub_features`} rel="sponsored nofollow noopener" target="_blank" referrerpolicy="no-referrer-when-downgrade" data-cta="hub_features">
          <span>評判を踏まえ TechGo 公式サイトで詳細を確認する</span>
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ============ SECTION 02 悪い評判 + 向き不向き ============ -->
  <section class="lp-section alt" id="sec-2" aria-labelledby="h2-2">
    <div class="container">
      <p class="section-num">SECTION / 02</p>
      <h2 id="h2-2">悪い評判・注意点と向いている人/向かない人</h2>
      <p class="section-lede">悪い評判 3 点を把握しつつ、向いている人/向かない人の 3 条件で判断することが推奨されます。</p>
      <div class="card-grid">
        <div class="card">
          <h3>悪い評判・注意点 (3 点)</h3>
          <p>① 担当者の質にバラつき (担当者数が多くベテラン vs 新人の経験差・合わない場合は変更依頼推奨) ② 求人紹介スピードが速すぎる場合あり (検討時間確保したい旨を事前申告) ③ ハイクラス・外資系は他社優勢 (年収 800 万円以上は JAC・ビズリーチ・ダイレクトスカウト等が優勢・併用推奨)</p>
        </div>
        <div class="card">
          <h3>向いている人 / 向かない人 (各 3 条件)</h3>
          <p>向いている人: ① 20-40 代の中堅層 ② 業界・職種を幅広く検討したい人 ③ 初回転職または経験 1-2 回。向かない人: ① ハイクラス特化 (年収 800 万+・JAC/ビズリーチ/ダイレクトスカウト併用推奨) ② 自分のペースで検討したい人 (要事前申告) ③ 外資系特化 (JAC International 等併用推奨)</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ SECTION 03 他社比較 ============ -->
  <section class="lp-section" id="sec-3" aria-labelledby="h2-3">
    <div class="container">
      <p class="section-num">SECTION / 03</p>
      <h2 id="h2-3">リクルートエージェントと他社エージェントの比較</h2>
      <div class="compare-wrap">
        <table class="compare" aria-label="転職エージェント主要比較">
          <thead><tr><th>エージェント</th><th>対象</th><th>強み</th><th>特徴</th></tr></thead>
          <tbody>
            <tr><td>リクルートエージェント</td><td>20-40 代全般</td><td>求人数 60 万件+</td><td>業界主要候補・公開情報ベース・全業界対応・キャリアアドバイザー充実</td></tr>
            <tr><td>doda</td><td>20-30 代中堅</td><td>求人数 + 自己分析サポート</td><td>スカウト機能 + エージェント機能の両軸</td></tr>
            <tr><td>マイナビエージェント</td><td>20 代第二新卒</td><td>若手特化・面接サポート</td><td>中小企業求人多・親身な対応評</td></tr>
            <tr><td>JAC Recruitment</td><td>30-40 代管理職</td><td>両面型・専門職</td><td>コンサル/IT/金融特化・ハイクラス</td></tr>
            <tr><td>ビズリーチ</td><td>経営層・高年収</td><td>スカウト型・年収 750 万+</td><td>ヘッドハンター直接スカウト</td></tr>
          </tbody>
        </table>
      </div>
      <p class="compare-note">※ 比較は各エージェント公開情報の整理 (参考値)。実際の求人数・対応範囲は変動します。</p>
      <div class="cta-block tight">
        <a class="btn-cta" href={`${A8}&sitemicros=hub_salary`} rel="sponsored nofollow noopener" target="_blank" referrerpolicy="no-referrer-when-downgrade" data-cta="hub_salary">
          <span>他社比較を踏まえ TechGo 公式サイトを確認する</span>
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ============ SECTION 04 まとめ + 3 軸併用戦略 ============ -->
  <section class="lp-section alt" id="sec-4" aria-labelledby="h2-4">
    <div class="container">
      <p class="section-num">SECTION / 04</p>
      <h2 id="h2-4">まとめ｜3 軸併用戦略と判断ポイント</h2>
      <div class="counter-box">
        <h3>📌 3 軸併用戦略 (公開情報整理)</h3>
        <div class="row"><b>STEP 1</b><span>リクルート (求人数) + 業界特化型 (専門性) + ハイクラス型 (年収アップ) の 3 社並行登録</span></div>
        <div class="row"><b>STEP 2</b><span>担当者との相性確認 (合わない場合は変更依頼)</span></div>
        <div class="row"><b>STEP 3</b><span>3-5 社面接で比較・最終判断</span></div>
        <div class="row"><b>向いている人</b><span>20-40 代中堅・幅広い業界検討・初回転職</span></div>
        <div class="row"><b>向かない人</b><span>ハイクラス特化・自分ペース重視・外資系特化</span></div>
        <p style="margin-top:12px;font-size:13px;color:var(--c-text-sub);">※ リクルートエージェントは求人数 60 万件以上 (業界主要候補・公開情報ベース) + キャリアアドバイザーの質 + 面接対策の充実が評価される一方、担当者の質バラつき・求人紹介スピードの速さ・ハイクラス特化での他社優勢の 3 点が指摘されています。<br /><strong>YMYL リスク認識</strong>: 年収・キャリアは就業判断に直結。本記事は転職成功保証ではなく、特定エージェントを推奨するものでもありません。</p>
      </div>

      <div class="cta-block">
        <a class="btn-cta" href={`${A8}&sitemicros=hub_final`} rel="sponsored nofollow noopener" target="_blank" referrerpolicy="no-referrer-when-downgrade" data-cta="hub_final">
          <span>最新求人の確認は TechGo 公式サイトで</span>
          <span class="arrow" aria-hidden="true">→</span>
        </a>
        <p class="btn-cta-sub">※ 本記事は 2026 年 5 月時点の公開情報をもとに作成。最新のリクルートエージェント情報は公式サイトでご確認ください。本記事は転職成功保証ではなく、特定エージェントを推奨するものでもありません。最終確認日: 2026-05-12。</p>
      </div>
    </div>
  </section>

  <!-- ============ SECTION 05 FAQ + 関連記事 ============ -->
  <section class="lp-section" id="sec-5" aria-labelledby="h2-5">
    <div class="container">
      <p class="section-num">SECTION / 05</p>
      <h2 id="h2-5">よくある質問・関連記事</h2>
      {faq.map((item) => (
        <div class="faq">
          <details>
            <summary>{item.q}</summary>
            <div>{item.a}</div>
          </details>
        </div>
      ))}
      <div class="card-grid">
        <div class="card">
          <h3>関連 Spoke LP</h3>
          <p>
            <a href="/osusume/">転職エージェント おすすめ</a> /
            <a href="/high-class/">ハイクラス転職</a> /
            <a href="/nenshu-up/">転職 年収アップ</a> /
            <a href="/mensetsu/">転職面接 自己紹介</a>
          </p>
        </div>
        <div class="card">
          <h3>公的相談窓口・支援機関</h3>
          <p>
            <a href="https://www.mhlw.go.jp/" target="_blank" rel="noopener">厚生労働省</a> — 職業情報提供サイト /
