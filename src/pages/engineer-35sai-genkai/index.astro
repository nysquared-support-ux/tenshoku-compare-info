import RichLayout from '../../layouts/RichLayout.astro';

const A8 = 'https://px.a8.net/svt/ejp?a8mat=4B1LPN+E39C6Q+5B0Y+HV7V6';
const title = 'エンジニア 35 歳限界説の真偽｜30 代後半-40 代の転職市場と戦略（2026年版・PR）';
const description = '「エンジニア 35 歳限界説」の真偽を、30 代後半-40 代の転職市場・必要スキル・キャリアパスで整理した情報提供記事です（PR・アフィリエイト広告を含みます）。';
const breadcrumb = [
  { name: 'ホーム', url: '/' },
  { name: 'IT エンジニア転職', url: '/high-class/' },
  { name: '35 歳限界説の真偽' },
];

const breadcrumbSchema = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  'itemListElement': [
    { '@type': 'ListItem', 'position': 1, 'name': 'トップ', 'item': 'https://tenshoku-compare-info.pages.dev/' },
    { '@type': 'ListItem', 'position': 2, 'name': '35 歳限界説の真偽', 'item': 'https://tenshoku-compare-info.pages.dev/engineer-35sai-genkai/' },
  ],
};
const faq = [
  { q: 'エンジニア 35 歳限界説は本当ですか?', a: '一般的に「35 歳でエンジニア寿命」は古い概念とされ、2026 年現在はハイクラス・専門特化エンジニアは 40 代・50 代でも市場価値が継続する傾向とされています。但しポテンシャル採用枠は減少傾向です。' },
  { q: '35 歳以降の転職で重視されることは?', a: '一般的にマネジメント力・専門特化スキル・実績の数値化が評価されているとされています。コードを書ける + 設計力 + チーム牽引力の組合せで高単価獲得事例があります。' },
  { q: '35 歳で未経験職種転職は可能ですか?', a: '一般的に 35 歳以降の完全未経験職種転職は厳しい傾向とされています。但し関連スキル + 学習意欲 + ネットワークでブリッジ転職事例はあるとされています。' },
  { q: 'マネジメント志向 vs スペシャリスト どちらが有利ですか?', a: '一般的に両方需要があり、年収面ではマネジメント (EM/CTO) + スペシャリスト (アーキテクト) ともに高単価帯とされています。自身の志向で選定が推奨されます。' },
];
const faqSchema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  'mainEntity': faq.map(f => ({ '@type': 'Question', 'name': f.q, 'acceptedAnswer': { '@type': 'Answer', 'text': f.a } })),
};
---

<RichLayout title={title} description={description} breadcrumb={breadcrumb}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
  </Fragment>

  <!-- ============ FV ============ -->
  <section class="fv" aria-labelledby="fv-h1">
    <div class="container">
