          <tbody>
            <tr><td>25-30</td><td>ポテンシャル + スキル</td><td>転職選択肢最大</td></tr>
            <tr><td>30-35</td><td>⭐ スキル成熟ピーク</td><td>スペシャリスト or マネジメント</td></tr>
            <tr><td>35-40</td><td>専門特化 + 実績</td><td>アーキテクト / EM / VPoE</td></tr>
            <tr><td>40-50</td><td>経営層 + ハイクラス</td><td>CTO / 経営層 / コンサル</td></tr>
          </tbody>
        </table>
