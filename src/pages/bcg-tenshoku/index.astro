const faq = [
  { q: 'BCG とはどんなファームですか?', a: 'BCG (ボストン コンサルティング グループ) は1963年創業の戦略コンサルティングファームで、McKinsey・Bain と並ぶ「3 大戦略ファーム (MBB)」の一角とされています。データドリブン分析 + 業界深耕 + コラボレーティブな組織文化が特徴とされる傾向です。' },
  { q: 'BCG の年収レンジはどのくらいですか?', a: '一般公開情報によれば、アソシエイト 700-1,000万円、コンサルタント 1,200-1,800万円、プロジェクトリーダー 1,800-2,500万円、プリンシパル 2,500-3,000万円、パートナー 3,000万円超の事例が報告されています。McKinsey・Bain と並ぶ業界最高水準とされる傾向です。詳細は <a href="/consul-nensyu/" class="underline">コンサル年収ガイド</a> 参照。' },
  { q: 'BCG の選考難度はどのくらいですか?', a: '一般的に「業界最難度クラス」とされ、ケース面接 + 構造化問題 + パートナー面接の複数ラウンド構成と一般的に言われます。独学では到達しにくく、元コンサルとの集中的な模擬面接 + 添削が一般的に推奨されます。詳細は <a href="/consul-case-mensetsu/" class="underline">ケース面接対策</a> 参照。' },
  { q: 'BCG の特徴的な強み領域は?', a: '一般公開情報によれば、テクノロジー・サステナビリティ・組織変革・人事戦略・デジタル変革等の領域で案件が多い傾向とされています。BCG X (デジタル組織) や BCG GAMMA (データサイエンス) 等の専門部門も展開されています。' },
  { q: 'BCG 卒業後のキャリアパスは?', a: '一般公開情報によれば、BCG 卒業生は事業会社 CEO / CXO ・ PE/VC パートナー・起業家・グローバル企業役員等の幅広いキャリアを歩む傾向とされています。アルムナイネットワークの活用価値が大きいとされる傾向です。' },
  { q: 'BCG と McKinsey どちらを選ぶべきですか?', a: 'BCG = データドリブン + コラボ重視 + テクノロジー強化、McKinsey = 経営層直結 + グローバルネットワーク + アルムナイ多数という特性の違いがあるとされています。詳細は <a href="/mckinsey-tenshoku/" class="underline">マッキンゼー 転職</a>・<a href="/senryaku-consul-tenshoku/" class="underline">戦略コンサル 転職</a> 参照。' },
];
const faqSchema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
