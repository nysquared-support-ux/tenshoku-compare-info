import RichLayout from '../../layouts/RichLayout.astro';

const title = 'コンサルファーム比較の整理｜選び方の方針 (2026年版・PR)';
const description = 'コンサルティングファーム比較の一般情報・選び方の方針を、公開情報をもとに中立的に整理した情報提供記事です(PR・アフィリエイト広告を含みます)。';
const breadcrumb = [
  { name: 'ホーム', url: '/' },
  { name: '比較' },
];
const faq = [
  { q: 'ファーム比較で見るべき点は？', a: '業務領域・働き方・カルチャー・キャリアパスが一般的な比較軸として整理されているとされています。' },
  { q: '戦略系と総合系の違いは？', a: '業務領域・案件規模・働き方が異なる選択肢として整理されているとされています。詳細はエージェント相談が推奨されます。' },
  { q: 'カルチャーはどう確認する？', a: '公開情報・面接時の質問・現役社員との接点が情報源として公表されているとされています。' },
  { q: '年収はファームで異なりますか？', a: '求人・ファームにより異なるとされていますが、専門性の高いポジションでは年収レンジが幅広い選択肢として整理されているとされています。' },
  { q: 'エージェントはファーム情報を持っていますか？', a: 'コンサル特化エージェントでは業界出身のアドバイザーによるファーム情報が公表されているとされています。' }
];
---

