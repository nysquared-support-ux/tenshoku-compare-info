const breadcrumb = [
  { name: 'ホーム', url: '/' },
  { name: 'コンサル転職ガイド', url: '/' },
  { name: 'コンサル MBA' },
];
const articleSchema = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  datePublished: '2026-05-21', dateModified: '2026-05-21',
  author: { '@type': 'Organization', name: 'NY-squared 編集部' },
  publisher: { '@type': 'Organization', name: 'NY-squared 編集部', url: 'https://tenshoku-compare-info.pages.dev/' },
};
const faq = [
  { q: 'コンサル転職に MBA は必要ですか?', a: '一般的に MBA はコンサル転職の必須条件ではないとされています。コンサル特化エージェントの公開情報によれば、利用者の9割が業界未経験で、MBA なしの転職成功事例も多いとされる傾向です。但し戦略系の一部や海外案件では MBA が評価されるケースもあるとされています。詳細は <a href="/consul-tenshoku-mikeiken/" class="underline">未経験 コンサル 転職</a> 参照。' },
  { q: 'MBA はコンサル選考でどう評価されますか?', a: '一般的に MBA はロジカルシンキング + ビジネス知識 + ネットワークの証明として一定の評価を受ける傾向とされています。但し「MBA 保有 = 内定」ではなく、ケース面接突破力 + 志望動機の論理性がより重視されるとされる傾向です。' },
  { q: 'MBA を取得するタイミングは?', a: '一般的に (1) コンサル転職前に取得 (2) コンサル在籍中に企業派遣で取得 (3) コンサル入社後に自費取得 の3パターンがあるとされています。戦略系では入社後にスポンサー付きで海外 MBA 派遣されるケースもあるとされる傾向です。' },
  { q: '国内 MBA と海外 MBA どちらが良いですか?', a: '一般的に海外トップ MBA はグローバル案件 + 戦略系で評価されやすく、国内 MBA は働きながら取得しやすい利点があるとされる傾向です。目的 (グローバルキャリア志向か否か) + 費用 + 期間で判断が分かれるとされています。' },
  { q: 'MBA なしでコンサル転職するには?', a: 'コンサル特化エージェントの公開情報によれば、MBA なしでも論理思考力 + ケース面接対策 + 志望動機の整理で転職可能とされる傾向です。元コンサル伴走の選考対策が一般的に推奨されます。詳細は <a href="/consul-case-mensetsu/" class="underline">ケース面接対策</a> 参照。' },
  { q: 'MBA 取得後のコンサルキャリアは?', a: '一般的に MBA 取得後はコンサルのコンサルタント〜マネージャー階層での採用 + 即戦力評価を受けやすい傾向とされています。MBA で得たネットワーク + ビジネス知識がキャリア後半でも活きるとされる傾向です。' },
];
