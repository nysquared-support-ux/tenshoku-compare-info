const articleSchema = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  datePublished: '2026-05-22', dateModified: '2026-05-22',
  author: { '@type': 'Organization', name: 'NY-squared 編集部' },
  publisher: { '@type': 'Organization', name: 'NY-squared 編集部', url: 'https://tenshoku-compare-info.pages.dev/' },
};
const faq = [
  { q: '文系出身という経歴は、コンサル転職で不利になりますか？', a: '一概に不利になるとは言えません。論理的思考力やコミュニケーション能力といったポータブルスキルが重視されるためです。厚生労働省の「労働経済の分析」でも、産業横断的なスキルセットの重要性が指摘されています。専門知識は入社後に習得可能と考えるファームも多く、文系ならではの強みを活かすことが重要とされます。' },
  { q: '文系未経験者がコンサル転職を目指す場合、最初に何をすべきですか？', a: 'まず自己分析で自身の強み（例：構造化能力、文章力）とコンサルタントの適性を結びつけます。次に業界研究で総合系、戦略系など自分に合う領域を見極めます。その後、ケース面接対策として書籍や転職エージェントの模擬面接を週2〜3回程度行うなど、具体的な計画を立てて進めるのが一般的な手順とされます。' },
  { q: '経済学部や法学部など、特定の学部が有利ということはありますか？', a: '特定の学部が絶対的に有利ということはありません。しかし、経済学で培われた論理的思考や法学部のリーガルマインドは、コンサル業務との親和性が高いと評価される傾向にあります。重要なのは学部名よりも、そこで培われた思考力や課題解決能力です。詳しくは「文系の強みがコンサルで評価される理由」のセクションもご参照ください。' },
  { q: '転職活動において、職務経歴書でアピールすべき点は何ですか？', a: '未経験の場合、現職での実績をコンサルタントの業務内容に結びつけて記述することが重要です。「課題を発見し、分析し、解決策を提案・実行した経験」を具体的な数値と共に示しましょう。職業安定法で定められた求人情報の的確な表示の観点からも、経歴を誇張せず、事実に基づき記述することが求められます。' },
  { q: '文系未経験からコンサル転職を成功させるための秘訣は何ですか？', a: '「なぜコンサルタントになりたいのか」という志望動機を深く掘り下げ、自身のキャリアプランと一貫性を持たせることが重要です。また、情報収集や選考対策を一人で行うには限界があるため、専門の転職エージェントが提供する無料カウンセリングなどを活用し、客観的なアドバイスを得ることも有効な手段と一般にいわれています。' },
];
const faqSchema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faq.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
